<Window x:Class="BreadboardAOI.App.Views.SymbolPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KICAD SYMBOL BROWSER"
        Width="560"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="11">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="BROWSE THE BUNDLED KICAD SYMBOL LIBRARY"
                       Style="{StaticResource StatusTextStyle}" />

            <TextBlock Grid.Row="1"
                       Text="Type part of a name: NE555, 74LS00, ATmega328, LM358. The id is stored on the part as its KiCad footprint."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10" />

            <TextBox x:Name="SearchBox"
                     Grid.Row="2"
                     Style="{StaticResource DockTextBoxStyle}"
                     Height="24"
                     VerticalAlignment="Top"
                     TextChanged="OnSearchChanged"
                     ToolTip="Symbol name search" />

            <ListBox x:Name="SymbolList"
                     Grid.Row="2"
                     Margin="0,30,0,0"
                     Background="{StaticResource EditorBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Row"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock x:Name="HintText"
                       Grid.Row="3"
                       Text=""
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="CLEAR"
                        Style="{StaticResource DockButtonStyle}"
                        Width="86"
                        Click="OnClear"
                        ToolTip="Use the kind's default symbol" />
                <Button Content="CANCEL"
                        Style="{StaticResource DockButtonStyle}"
                        Width="86"
                        IsCancel="True" />
                <Button x:Name="UseButton"
                        Content="USE SYMBOL"
                        Style="{StaticResource DockButtonStyle}"
                        Width="110"
                        IsDefault="True"
                        Click="OnUse"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
