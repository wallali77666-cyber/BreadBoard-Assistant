<Window x:Class="BreadboardAOI.App.Views.AiVisionInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI LIVE STUDIO · BREADBOARD VISION &amp; DIAGNOSIS"
        Width="1440"
        Height="880"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PasteboardBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="11">

    <Window.Resources>
        <Style x:Key="StudioReadOnlyTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioHeaderButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DockButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="StudioAccentButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DockButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PasteboardBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI LIVE STUDIO"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <Border Background="{StaticResource EditorBackgroundBrush}"
                                    BorderBrush="{StaticResource AccentBlueBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="6,1"
                                    Margin="10,0,0,0">
                                <TextBlock Text="VISION + DRC"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="TutorBadgeBorder"
                                    Background="{StaticResource EditorBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="7,2"
                                    Margin="6,0,0,0"
                                    MaxWidth="380"
                                    ToolTip="Green light: the Qwen endpoint answered /health or /v1/models.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="TutorStatusLight"
                                             Width="8"
                                             Height="8"
                                             Margin="0,0,6,0"
                                             Fill="{StaticResource TextMutedBrush}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="TutorStatusGlow"
                                                              Color="#10B981"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="TutorBadgeText"
                                               Text="TUTOR: CHECKING ..."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="LinkLmStudioButton"
                                    Content="LINK LM STUDIO"
                                    Style="{StaticResource StudioHeaderButtonStyle}"
                                    Margin="6,0,0,0"
                                    Padding="8,3"
                                    FontSize="9"
                                    Click="OnLinkLmStudioClick"
                                    ToolTip="Directly link to local LM Studio server at http://127.0.0.1:1234. Connects to whichever model is loaded." />
                        </StackPanel>
                        <TextBlock Text="LIVE CAMERA &amp; PHOTO INSPECTION  ·  STREAMING REASONING &amp; RESULTS  ·  VOICE REFLEX"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="8.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Layout Mode Selector -->
                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="2"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="DualViewModeButton"
                                          Content="DUAL (LIVE + PHOTO)"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Padding="8,3"
                                          Margin="0,0,2,0"
                                          IsChecked="True"
                                          Click="OnDualViewClick"
                                          ToolTip="Show both the live 60 FPS camera feed and the uploaded photo side-by-side." />
                            <ToggleButton x:Name="LiveOnlyModeButton"
                                          Content="LIVE CAMERA"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Padding="8,3"
                                          Margin="0,0,2,0"
                                          Click="OnLiveOnlyClick"
                                          ToolTip="Expand the 60 FPS live camera feed to full width." />
                            <ToggleButton x:Name="PhotoOnlyModeButton"
                                          Content="UPLOADED PHOTO"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Padding="8,3"
                                          Margin="0"
                                          Click="OnPhotoOnlyClick"
                                          ToolTip="Expand the uploaded photo inspection view to full width." />
                        </StackPanel>
                    </Border>

                    <Button Content="UPLOAD IMAGE"
                            Style="{StaticResource StudioAccentButtonStyle}"
                            Click="OnUploadClick"
                            ToolTip="Load a breadboard photo: view it, send it to Qwen, watch thinking &amp; results stream live, and hear spoken instructions." />
                    <Button x:Name="AnalyzeVideoButton"
                            Content="ANALYZE VIDEO (CAM)"
                            Style="{StaticResource StudioHeaderButtonStyle}"
                            Click="OnAnalyzeVideoClick"
                            ToolTip="Analyze current live camera video frame with Qwen AI." />
                    <Button x:Name="AnalyzePhotoButton"
                            Content="ANALYZE PHOTO"
                            Style="{StaticResource StudioHeaderButtonStyle}"
                            Click="OnAnalyzePhotoClick"
                            ToolTip="Analyze the uploaded breadboard photo with Qwen AI." />
                    <Button Content="BACK TO WORKSTATION"
                            Style="{StaticResource StudioHeaderButtonStyle}"
                            Margin="0"
                            Click="OnCloseClick"
                            ToolTip="Return to the CAD workstation (ESC)." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="680" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="460" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Vision viewports (Live Camera and/or Uploaded Photo) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sub-toolbar -->
                <Border Grid.Row="0"
                        Background="{StaticResource ToolbarSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,0">
                    <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INSPECTION VIEWPORTS" Style="{StaticResource DockHeaderTextStyle}" />
                            <Border Width="1" Height="14" Margin="10,0" Background="{StaticResource BorderBrush}" />
                            <CheckBox x:Name="ShowBoxesCheckBox"
                                      Content="PARTS"
                                      IsChecked="True"
                                      Style="{StaticResource LayerCheckBoxStyle}"
                                      Margin="0,0,10,0"
                                      Click="OnOverlayLayerToggled" />
                            <CheckBox x:Name="ShowPinsCheckBox"
                                      Content="PINS"
                                      IsChecked="True"
                                      Style="{StaticResource LayerCheckBoxStyle}"
                                      Margin="0,0,10,0"
                                      Click="OnOverlayLayerToggled" />
                            <CheckBox x:Name="ShowFaultsCheckBox"
                                      Content="FAULTS"
                                      IsChecked="True"
                                      Style="{StaticResource LayerCheckBoxStyle}"
                                      Margin="0,0,10,0"
                                      Click="OnOverlayLayerToggled" />
                        </StackPanel>
                        <TextBlock x:Name="ViewportSummaryText"
                                   DockPanel.Dock="Right"
                                   Text="DUAL VIEW ACTIVE · LIVE CAMERA &amp; UPLOADED PHOTO"
                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Dynamic Viewports Container -->
                <Grid Grid.Row="1" x:Name="ViewportsGrid" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LiveColDef" Width="*" />
                        <ColumnDefinition x:Name="SplitterColDef" Width="6" />
                        <ColumnDefinition x:Name="PhotoColDef" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- PANEL A: LIVE CAMERA STREAM (60 FPS) -->
                    <Border Grid.Column="0"
                            x:Name="LiveViewportBorder"
                            Background="#0B0B0B"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource ToolbarSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0">
                                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" />
                                        <TextBlock Text="LIVE VIDEO (CAMERA)" Style="{StaticResource DockHeaderTextStyle}" FontSize="9.5" />
                                        <Button x:Name="LiveCamSourceButton"
                                                Content="SELECT CAMERA &#x25BE;"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="8,0,0,0"
                                                Padding="6,1"
                                                FontSize="8.5"
                                                Click="OnLiveCamSourceMenuClick"
                                                ToolTip="Choose video device: Camera 0, Camera 1, Camera 2, Synthetic, or Video File." />
                                        <Button Content="LOAD VIDEO"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="4,0,0,0"
                                                Padding="6,1"
                                                FontSize="8.5"
                                                Click="OnLoadLiveVideoClick"
                                                ToolTip="Load a recorded breadboard inspection video (MP4, AVI, MKV, MOV, WEBM) for live replay." />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveMetaText"
                                                   Text="1000 &#x00D7; 500 &#x00B7; 60 FPS"
                                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                                   FontSize="8.5"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="&#x2212;" Width="18" Height="18" Style="{StaticResource DockButtonStyle}" Margin="1,0" Padding="0" Click="OnLiveZoomOutClick" ToolTip="Zoom Out (Mouse Wheel Down)" />
                                        <TextBlock x:Name="LiveZoomText" Text="100%" Style="{StaticResource MonoSecondaryTextStyle}" FontSize="8.5" VerticalAlignment="Center" Width="30" TextAlignment="Center" />
                                        <Button Content="+" Width="18" Height="18" Style="{StaticResource DockButtonStyle}" Margin="1,0" Padding="0" Click="OnLiveZoomInClick" ToolTip="Zoom In (Mouse Wheel Up)" />
                                        <Button Content="FIT" Height="18" Style="{StaticResource DockButtonStyle}" Margin="2,0,0,0" Padding="4,0" FontSize="8" Click="OnLiveZoomFitClick" ToolTip="Reset Zoom (Fit)" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,4">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource EditorBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="2"
                                            Margin="0,1,6,1">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="ManualCaptureModeButton"
                                                          Content="MANUAL CAPTURE"
                                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                                          Padding="7,2"
                                                          FontSize="8.5"
                                                          Margin="0,0,2,0"
                                                          IsChecked="True"
                                                          Click="OnManualCaptureModeClick"
                                                          ToolTip="Manual mode: live stream runs continuously; click CAPTURE &amp; ANALYZE NOW to inspect a settled frame." />
                                            <ToggleButton x:Name="AutoHandsFreeModeButton"
                                                          Content="AUTO (NO HANDS ON BOARD)"
                                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                                          Padding="7,2"
                                                          FontSize="8.5"
                                                          Click="OnAutoHandsFreeModeClick"
                                                          ToolTip="Auto hands-free mode: waits until your hands leave the breadboard and motion stabilizes, then snaps and sends to Qwen." />
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="CaptureAnalyzeNowButton"
                                            Content="&#x1F4F8; CAPTURE &amp; ANALYZE NOW"
                                            Style="{StaticResource StudioAccentButtonStyle}"
                                            Padding="8,3"
                                            FontSize="8.5"
                                            Margin="0,1,6,1"
                                            Click="OnCaptureAndAnalyzeLiveClick"
                                            ToolTip="Capture the current live camera frame into the snapshot panel and inspect it with Qwen Vision now." />

                                    <Border x:Name="HandGateBadgeBorder"
                                            Background="{StaticResource EditorBackgroundBrush}"
                                            BorderBrush="{StaticResource LedOnlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="6,2"
                                            Margin="0,1,4,1"
                                            ToolTip="Real-time Hand Motion Gate status (skin + frame-motion gating).">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="HandGateDot"
                                                     Width="6"
                                                     Height="6"
                                                     Margin="0,0,5,0"
                                                     Fill="{StaticResource LedOnlineBrush}" />
                                            <TextBlock x:Name="HandGateStatusText"
                                                       Text="&#x2713; NO HANDS &#x00B7; BOARD STABLE"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="8.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <ProgressBar x:Name="HandSettleProgressBar"
                                                 Width="70"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="100"
                                                 VerticalAlignment="Center"
                                                 Margin="2,1,0,1"
                                                 Foreground="{StaticResource LedOnlineBrush}"
                                                 Background="{StaticResource EditorBackgroundBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 BorderThickness="1" />
                                </WrapPanel>
                            </Border>

                            <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="Both" Margin="4"
                                     MouseWheel="OnLiveViewportMouseWheel"
                                     MouseDown="OnLiveViewportMouseDown"
                                     MouseMove="OnLiveViewportMouseMove"
                                     MouseUp="OnLiveViewportMouseUp">
                                <Grid x:Name="LiveViewportContainer" Width="1000" Height="500" Background="#0B0B0B" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="LiveScaleTransform" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="LiveTranslateTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Image x:Name="LiveFrameImage"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="LiveOverlayCanvas"
                                            Width="1000"
                                            Height="500"
                                            IsHitTestVisible="False" />
                                    <TextBlock x:Name="LivePlaceholder"
                                               Text="WAITING FOR CAMERA STREAM&#10;Connecting to video pipeline..."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11" />
                                    <Border x:Name="LiveOverlayNotice"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,12"
                                            Padding="8,3"
                                            Background="{StaticResource PanelBackgroundBrush}"
                                            BorderBrush="{StaticResource DrcWarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <TextBlock x:Name="LiveOverlayNoticeText"
                                                   Text="AR OVERLAYS HELD · AIM AT ALL FOUR ARUCO MARKERS"
                                                   Foreground="{StaticResource DrcWarningBrush}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9" />
                                    </Border>
                                </Grid>
                            </Viewbox>

                            <Border Grid.Row="3"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="8,0">
                                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveStatusText"
                                               Text="LIVE CAMERA ACTIVE"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               FontSize="8.5"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               x:Name="LiveOverlayStateText"
                                               Text="AR OVERLAYS ON"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="8.5"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter between viewports -->
                    <GridSplitter Grid.Column="1"
                                  x:Name="ViewportSplitter"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- PANEL B: UPLOADED PHOTO INSPECTION -->
                    <Border Grid.Column="2"
                            x:Name="PhotoViewportBorder"
                            Background="#0B0B0B"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            ClipToBounds="True"
                            AllowDrop="True"
                            DragOver="OnPhotoDragOver"
                            Drop="OnPhotoDrop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource ToolbarSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0">
                                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="UPLOADED IMAGE (INSPECTION)" Style="{StaticResource DockHeaderTextStyle}" FontSize="9.5" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PhotoMetaText"
                                                   Text="NO PHOTO LOADED"
                                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                                   FontSize="8.5"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="&#x2212;" Width="18" Height="18" Style="{StaticResource DockButtonStyle}" Margin="1,0" Padding="0" Click="OnPhotoZoomOutClick" ToolTip="Zoom Out (Mouse Wheel Down)" />
                                        <TextBlock x:Name="PhotoZoomText" Text="100%" Style="{StaticResource MonoSecondaryTextStyle}" FontSize="8.5" VerticalAlignment="Center" Width="30" TextAlignment="Center" />
                                        <Button Content="+" Width="18" Height="18" Style="{StaticResource DockButtonStyle}" Margin="1,0" Padding="0" Click="OnPhotoZoomInClick" ToolTip="Zoom In (Mouse Wheel Up)" />
                                        <Button Content="FIT" Height="18" Style="{StaticResource DockButtonStyle}" Margin="2,0,6,0" Padding="4,0" FontSize="8" Click="OnPhotoZoomFitClick" ToolTip="Reset Zoom (Fit)" />
                                        <Button Content="BROWSE"
                                                Style="{StaticResource DockButtonStyle}"
                                                Padding="6,1"
                                                FontSize="8.5"
                                                Click="OnUploadClick"
                                                ToolTip="Upload an image file from disk" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="4"
                                     MouseWheel="OnPhotoViewportMouseWheel"
                                     MouseDown="OnPhotoViewportMouseDown"
                                     MouseMove="OnPhotoViewportMouseMove"
                                     MouseUp="OnPhotoViewportMouseUp">
                                <Grid x:Name="PhotoViewportContainer" Width="1000" Height="500" Background="#0B0B0B" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PhotoScaleTransform" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="PhotoTranslateTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Image x:Name="PhotoFrameImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="PhotoOverlayCanvas"
                                            Width="1000"
                                            Height="500"
                                            IsHitTestVisible="False" />
                                    <Border x:Name="PhotoPlaceholder"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#141414"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="20,14"
                                            Cursor="Hand"
                                            MouseDown="OnUploadClick">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DRAG &amp; DROP PHOTO HERE"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="or click to browse from file (.png, .jpg, .webp)"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Viewbox>

                            <Border Grid.Row="2"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="8,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PhotoStatusText"
                                               Grid.Column="0"
                                               Text="READY FOR PHOTO UPLOAD"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               FontSize="8.5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="PhotoActionBadge"
                                               Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="AUTO-QWEN ON LOAD"
                                               Foreground="{StaticResource DrcPassBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="8.5"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Main Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Column 2: Cognitive & Diagnostic Suite (Right Panel) -->
            <ScrollViewer Grid.Column="2"
                          Background="{StaticResource PanelBackgroundBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,12">
                    <!-- SECTION 1: QWEN VISION INPUT -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock Text="QWEN VISION INPUT" Style="{StaticResource DockHeaderTextStyle}" />
                            <TextBlock x:Name="VisionInputMetaText"
                                       DockPanel.Dock="Right"
                                       Text="NONE"
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource EditorBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Height="112"
                            Padding="8,4">
                        <Grid>
                            <Image x:Name="VisionInputImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="VisionInputPlaceholder"
                                       Text="The exact PNG sent to Qwen AI appears here."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5" />
                        </Grid>
                    </Border>

                    <!-- SECTION 2: THINKING & REASONING -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6"
                            Margin="0,4,0,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ThinkingDot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource TextMutedBrush}"
                                         Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="ThinkingDotGlow"
                                                          Color="#10B981"
                                                          BlurRadius="6"
                                                          ShadowDepth="0"
                                                          Opacity="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="THINKING &amp; REASONING" Style="{StaticResource DockHeaderTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ThinkingStatusText"
                                       DockPanel.Dock="Right"
                                       Text="IDLE"
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="ThinkingTextBox"
                             Style="{StaticResource StudioReadOnlyTextBoxStyle}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="9.5"
                             Height="110"
                             Margin="10,4,10,0" />

                    <!-- SECTION 3: RESULT · DIAGNOSIS -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,6"
                            Margin="0,6,0,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock Text="RESULT · DIAGNOSIS" Style="{StaticResource DockHeaderTextStyle}" />
                            <TextBlock x:Name="ResultStatusText"
                                       DockPanel.Dock="Right"
                                       Text="NO ANSWER"
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="ResultTextBox"
                             Style="{StaticResource StudioReadOnlyTextBoxStyle}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="11"
                             Height="130"
                             Margin="10,4,10,0" />

                    <!-- SECTION 4: INSTRUCTIONS & VOICE -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,6"
                            Margin="0,6,0,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock Text="INSTRUCTIONS &amp; VOICE" Style="{StaticResource DockHeaderTextStyle}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="AutoSpeakCheckBox"
                                          Content="AUTO-SPEAK"
                                          IsChecked="True"
                                          Style="{StaticResource LayerCheckBoxStyle}"
                                          Margin="0,0,7,0"
                                          FontSize="9"
                                          ToolTip="Automatically speak repair instructions via TTS when analysis completes." />
                                <Button x:Name="SpeakResultButton"
                                        Content="VOICE"
                                        Style="{StaticResource DockButtonStyle}"
                                        Padding="7,2"
                                        Margin="0"
                                        IsEnabled="False"
                                        Click="OnSpeakResultClick"
                                        ToolTip="Speak or replay the repair instruction out loud." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- VOICE CONTROLS: Engine & ElevenLabs Voice Selection -->
                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,4">
                        <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                <TextBlock Text="ENGINE:" Style="{StaticResource MonoSecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="9" />
                                <Button x:Name="TestVoiceButton" DockPanel.Dock="Right" Content="TEST" Style="{StaticResource DockButtonStyle}" Margin="6,0,0,0" Padding="8,2" Click="OnTestVoiceClick" ToolTip="Test active voice playback" />
                                <ComboBox x:Name="VoiceEngineComboBox" Height="22" FontSize="9.5">
                                    <ComboBoxItem Content="AUTO (SMART)" Tag="auto" />
                                    <ComboBoxItem Content="ELEVENLABS" Tag="elevenlabs" />
                                    <ComboBoxItem Content="PIPER (LOCAL)" Tag="piper" />
                                    <ComboBoxItem Content="WINDOWS SAPI" Tag="sapi" />
                                </ComboBox>
                            </DockPanel>
                            <StackPanel x:Name="ElevenLabsConfigRow" Orientation="Vertical">
                                <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                    <TextBlock Text="API KEY:" Style="{StaticResource MonoSecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="9" />
                                    <Button x:Name="SaveApiKeyButton" DockPanel.Dock="Right" Content="SAVE KEY" Style="{StaticResource DockButtonStyle}" Margin="6,0,0,0" Padding="8,2" Click="OnSaveApiKeyClick" ToolTip="Save ElevenLabs API key and load custom voices" />
                                    <PasswordBox x:Name="ElevenLabsApiKeyBox" Height="22" FontSize="9.5" ToolTip="Paste ElevenLabs API key (from elevenlabs.io)" />
                                </DockPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="ELEVEN VOICE:" Style="{StaticResource MonoSecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="9" />
                                    <Button x:Name="RefreshVoicesButton" DockPanel.Dock="Right" Content="REFRESH" Style="{StaticResource DockButtonStyle}" Margin="6,0,0,0" Padding="8,2" Click="OnRefreshVoicesClick" ToolTip="Refresh voices from ElevenLabs account" />
                                    <ComboBox x:Name="ElevenLabsVoiceComboBox" Height="22" FontSize="9.5" DisplayMemberPath="DisplayName" />
                                </DockPanel>
                                <TextBlock x:Name="ElevenLabsKeyHintText" Text="* Paste your ElevenLabs key above to hear distinct neural voices." Style="{StaticResource MonoSecondaryTextStyle}" Foreground="#FFB74D" FontSize="8.5" Margin="0,2,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="InstructionTextBox"
                             Style="{StaticResource StudioReadOnlyTextBoxStyle}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="9.5"
                             Height="110"
                             Margin="10,4,10,0"
                             Text="Upload an image or wait for the live frame. AI repair instructions will appear here in at most 5 sentences." />

                    <!-- SECTION 5: COMPUTE ALLOCATION (CPU & GPU) -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,6"
                            Margin="0,6,0,0">
                        <TextBlock Text="COMPUTE ALLOCATION (CPU &amp; GPU)" Style="{StaticResource DockHeaderTextStyle}" FontSize="9.5" />
                    </Border>
                    <Border Background="{StaticResource EditorBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="10,4,10,0"
                            Padding="8,6">
                        <StackPanel>
                            <TextBlock x:Name="CpuAllocationDetailText"
                                       Text="CPU: RESOLVING AFFINITY PLAN..."
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="8.5"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GpuAllocationDetailText"
                                       Text="GPU: RESOLVING DEVICE..."
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="8.5"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- SECTION 6: CONTROLS & STATUS -->
                    <Border Background="{StaticResource ToolbarSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock x:Name="AnalysisStatusText"
                                       Text="READY"
                                       Style="{StaticResource MonoSecondaryTextStyle}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AnalyzeButton"
                                        Content="ANALYZE"
                                        Style="{StaticResource StudioAccentButtonStyle}"
                                        Margin="0,0,5,0"
                                        Click="OnAnalyzeAgainClick" />
                                <Button x:Name="StopButton"
                                        Content="STOP"
                                        Style="{StaticResource StudioHeaderButtonStyle}"
                                        Margin="0"
                                        IsEnabled="False"
                                        Click="OnStopClick" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status footer -->
        <Border Grid.Row="2"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <TextBlock x:Name="BottomStatusText"
                           Text="AI LIVE STUDIO READY · UPLOAD A PHOTO OR WAIT FOR THE LIVE FRAME"
                           Style="{StaticResource MonoSecondaryTextStyle}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="760" />
                <TextBlock x:Name="HardwareAllocationText"
                           DockPanel.Dock="Right"
                           Text="CPU: AI -- · VIS -- · UI -- | GPU: --"
                           Style="{StaticResource MonoSecondaryTextStyle}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <TextBlock x:Name="VoiceBackendText"
                           DockPanel.Dock="Right"
                           Text="VOICE: CHECKING"
                           Style="{StaticResource MonoSecondaryTextStyle}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="ESC CLOSE"
                           Style="{StaticResource MonoSecondaryTextStyle}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>