<Window x:Class="BreadboardAOI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="BreadboardAOI — 830-Point Inspection Workstation"
        Height="900" Width="1500"
        MinHeight="540" MinWidth="1000"
        Background="{StaticResource PasteboardBrush}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/BreadboardAOI.App;component/Resources/app.ico">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCircuitPartCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding RedoCircuitPartCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCircuitPartCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================
             ZONE 1 — COMMAND BAR
             ================================================================ -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <DockPanel LastChildFill="False" Margin="10,5">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Border Width="26" Height="26" Margin="0,0,10,0"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <Image Source="pack://application:,,,/BreadboardAOI.App;component/Resources/app_icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding AppSubtitle}" FontSize="9"
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel DockPanel.Dock="Left"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <!-- INSPECT -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="INSPECT" Style="{StaticResource ToolbarGroupLabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="DEMO MODE"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding DemoModeEnabled, Mode=TwoWay}"
                                          ToolTip="Inject a deterministic faulty circuit so the DRC engine and tutor can be exercised without a camera." />
                            <ToggleButton Content="X-RAY"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowAllStrips, Mode=TwoWay}"
                                          ToolTip="Reveal all 126 conductive clips behind the board so shorts are easy to see." />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="0,2,10,0" />

                    <!-- DEV BOARD PLATFORM SWITCHER -->
                    <StackPanel Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DEV BOARD" Style="{StaticResource ToolbarGroupLabelStyle}" />
                            <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveDevBoardName}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="UNO" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="uno" ToolTip="Arduino Uno R3/R4 (ATmega328P, 5V Logic)" />
                            <Button Content="MEGA" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="mega" ToolTip="Arduino Mega 2560 (54 DIO, 5V Logic)" />
                            <Button Content="ESP32" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="esp32" ToolTip="ESP32 DevKit V1 (3.3V Logic, Dual Xtensa, Wi-Fi/BLE)" />
                            <Button Content="S2 MINI" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="s2" ToolTip="WEMOS ESP32-S2 Mini (3.3V Logic, Type-C OTG)" />
                            <Button Content="STM32" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="stm32" ToolTip="STM32 Blue Pill ARM Cortex-M3 (3.3V Logic, 5V-Tolerant GPIO)" />
                            <Button Content="NO MCU" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RemoveDevBoardCommand}" ToolTip="Remove Dev Board (Pure Standalone Breadboard Mode)" Background="#3B4252" Foreground="#D8DEE9" />
                            <ToggleButton Content="DOCK" Style="{StaticResource ToolbarToggleButtonStyle}" IsChecked="{Binding IsDevBoardDocked, Mode=TwoWay}" ToolTip="Dock/Undock Dev Board beside breadboard in CAD viewport" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="0,2,10,0" />
                    <!-- IMAGE -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="IMAGE" Style="{StaticResource ToolbarGroupLabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding CameraLabel}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding CycleCameraCommand}"
                                    ToolTip="Cycle Synthetic board → Camera 0 → Camera 1." />
                            <Button Content="LOAD IMAGE"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding LoadImageFileCommand}"
                                    ToolTip="Replay a breadboard photo as the camera frame. You can also drag a photo onto the CAD viewport." />
                            <Button Content="AI STUDIO"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OpenAiVisionInspectorCommand}"
                                    ToolTip="Open the AI Live Studio: live camera or uploaded photo, Qwen thinking, action-first result, and voice." />
                            <Button Content="BOX CODE"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OpenBoxCodingStudioCommand}"
                                    Background="#6A1B9A" Foreground="#E1BEE7" FontWeight="Bold"
                                    ToolTip="Open Scratch-Style Box Coding Studio: visual block coding for dev board and sensors." />
                            <Button Content="WIRING GUIDE"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OpenWiringGuideStudioCommand}"
                                    Background="#00695C" Foreground="#B2DFDB" FontWeight="Bold"
                                    ToolTip="Open DevBoard &amp; Sensor Wiring Guide Studio: step-by-step connection instructions and tutor." />
                            <ToggleButton Content="PIN LABELS"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowSensorPinLabels, Mode=TwoWay}"
                                          ToolTip="Toggle live AR pin badges on sensors and components (VCC, GND, TRIG, ECHO, etc.)" />
                            <ToggleButton Content="WIRING DOCK"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding IsWiringGuideDocked, Mode=TwoWay}"
                                          ToolTip="Toggle docking the DevBoard-Sensor Wiring Guide in the Left Panel" />
                            <ToggleButton Content="LCD SIM"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowLcdSimulation, Mode=TwoWay}"
                                          ToolTip="Toggle live 16x2 Character LCD AR visual simulation on breadboard (Blue backlight + dot matrix text)" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="0,2,10,0" />

                    <!-- DIAGNOSE -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="DIAGNOSE" Style="{StaticResource ToolbarGroupLabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ASK AI"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AskAiCommand}"
                                    ToolTip="Sends the active circuit to Qwen AI for multimodal diagnostic and repair guidance." />
                            <Button Content="REPLAY DIAGNOSTIC"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ReplayDiagnosticCommand}" />
                            <Button Content="TEST ALARM"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding TestAlarmCommand}" />
                            <ToggleButton Content="MUTE VOICE"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding IsVoiceMuted, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>

                <Button DockPanel.Dock="Right"
                        Content="PANELS"
                        Style="{StaticResource ToolbarButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Command="{Binding RestoreDocksCommand}"
                        ToolTip="Restore both tool docks and open the VIEW layout panel. Works after WIDE CANVAS hides them." />
            </DockPanel>
        </Border>

        <!-- ================================================================
             ZONE 2 — DOCKING WORK AREA (left scene dock / centre CAD / right DRC)
             ================================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftDockColumnWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding RightDockColumnWidth}" />
            </Grid.ColumnDefinitions>

            <!-- LEFT DOCK -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsLeftDockVisible, Converter={StaticResource BoolToVis}}">
                <TabControl x:Name="LeftDockTabs"
                            Style="{StaticResource DockTabControlStyle}"
                            SelectionChanged="OnLeftDockTabChanged"
                            SelectedIndex="{Binding SelectedLeftTabIndex, Mode=TwoWay}">
                    <!-- ============================ SCENE ============================ -->
                    <TabItem Header="SCENE" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="DEMO FAULTS" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <ListBox Style="{StaticResource WorkstationListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ScenarioListItemStyle}"
                                         ItemsSource="{Binding ScenarioItems}"
                                         SelectedItem="{Binding SelectedScenario, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource ScenarioTitleTextStyle}" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource ScenarioDetailTextStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="NETLIST &amp; LAYERS" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox Content="Show pin matrix dots (830)"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowPinMatrixDots, Mode=TwoWay}" />
                                    <CheckBox Content="Show X-ray metal clips"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowXRayStrips, Mode=TwoWay}" />
                                    <CheckBox Content="Show all 126 clips (X-ray)"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowAllStrips, Mode=TwoWay}" />
                                    <CheckBox Content="Show KiCad ratsnest arrows"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowRatsnestArrows, Mode=TwoWay}" />
                                    <CheckBox Content="Show CAD detection boxes"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowComponentBoxes, Mode=TwoWay}" />
                                    <CheckBox Content="Show realistic part symbols"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowRealisticParts, Mode=TwoWay}" />
                                    <CheckBox Content="Show component labels"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowComponentLabels, Mode=TwoWay}" />
                                    <CheckBox Content="Show sensor &amp; component pin labels"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowSensorPinLabels, Mode=TwoWay}"
                                              ToolTip="Live AR pin labels on sensors and components (VCC, GND, TRIG, ECHO, A+, K-)" />
                                    <CheckBox Content="Simulate 16x2 I2C LCD screen"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowLcdSimulation, Mode=TwoWay}"
                                              ToolTip="Renders blue backlight and live simulated dot-matrix text on placed 16x2 LCD modules" />
                                    <CheckBox Content="Show CAD rulers"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowRulers, Mode=TwoWay}" />
                                    <CheckBox Content="Show telemetry HUD"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowTelemetry, Mode=TwoWay}" />
                                    <CheckBox Content="Show camera / photo underlay"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding ShowCameraUnderlay, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="HARDWARE / TELEMETRY" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <TextBlock Text="{Binding VisionBackend}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TutorBackend}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding VoiceBackend}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding VramTelemetry}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding AffinityTelemetry}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TargetNetlistStatus}" Style="{StaticResource MonoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =========================== BUILDER =========================== -->
                    <TabItem Header="BUILDER" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer x:Name="BuilderScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="X-RAY CIRCUIT BUILDER" Style="{StaticResource DockHeaderTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding CircuitSummary}"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </DockPanel>
                                </Border>

                                <StackPanel Margin="12,8,12,10">
                                    <DockPanel LastChildFill="False">
                                        <ToggleButton Content="BUILD MODE"
                                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                                      IsChecked="{Binding IsBuildMode, Mode=TwoWay}"
                                                      ToolTip="Hand the netlist to the builder. The DRC then judges only the parts below." />
                                        <Button DockPanel.Dock="Right"
                                                Content="ASK AI"
                                                Style="{StaticResource DockButtonStyle}"
                                                Padding="10,2"
                                                Command="{Binding AskAiCommand}"
                                                ToolTip="Sends the current hand-built circuit and DRC violations to Qwen AI for diagnosis." />
                                    </DockPanel>

                                    <Button Content="ASK AI TUTOR (DIAGNOSE CIRCUIT)"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0"
                                            Command="{Binding AskAiCommand}"
                                            ToolTip="Sends the current hand-built circuit and DRC violations to Qwen AI for multimodal diagnosis and repair guidance." />

                                    <TextBlock Text="Left click a tie point for lead 1, then a second tie point for lead 2. Right click removes the last part touching that hole."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <!-- ======================================================== -->
                                    <!-- PERSISTENT DEV BOARD PLATFORM & CONTROLLER CARD          -->
                                    <!-- ======================================================== -->
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,7" Margin="0,4,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="DEV BOARD &amp; CONTROLLER" Style="{StaticResource StatusTextStyle}" FontWeight="Bold" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding ActiveDevBoardName}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <!-- 5 DEV BOARD BUTTONS -->
                                            <UniformGrid Columns="2" Margin="0,2,0,3">
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="uno"
                                                        ToolTip="Arduino Uno R3 / R4 (ATmega328P, 14 DIO, 6 AIN, 5V Logic)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#00979D" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="ARDUINO UNO" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="mega"
                                                        ToolTip="Arduino Mega 2560 (ATmega2560, 54 DIO, 16 AIN, 4 UARTs, 5V Logic)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#00838F" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="MEGA 2560" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="esp32"
                                                        ToolTip="ESP32 DevKit V1 (ESP-WROOM-32, Dual Xtensa LX6, Wi-Fi/BLE, 3.3V Logic)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#E65100" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="ESP32 DEVKIT" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="s2"
                                                        ToolTip="WEMOS ESP32-S2 Mini (ESP32-S2FN4R2, Native USB OTG, 27 GPIO, Purple PCB)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#7B1FA2" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="WEMOS S2 MINI" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1,0,1,4"
                                                    Command="{Binding SelectDevBoardTypeCommand}" CommandParameter="stm32"
                                                    ToolTip="STM32 Blue Pill (STM32F103C8T6 ARM Cortex-M3 72MHz, 32 GPIO, 3.3V Logic, Blue PCB)">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="#1976D2" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="STM32 BLUE PILL (F103C8)" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding RemoveDevBoardCommand}"
                                                        ToolTip="Remove Dev Board (Pure Standalone Breadboard Mode)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="✕" Foreground="#E06C75" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="REMOVE" FontWeight="SemiBold" FontSize="9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding OpenBoxCodingStudioCommand}"
                                                        Background="#3B1C54" BorderBrush="#8A2BE2"
                                                        ToolTip="Launch Visual Scratch-Style Box Coding Studio for this Board">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="⚡" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="BOX CODE" FontWeight="Bold" FontSize="9" Foreground="#E1BEE7" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding OpenWiringGuideStudioCommand}"
                                                        Background="#004D40" BorderBrush="#00897B"
                                                        ToolTip="Launch Step-by-Step Wiring &amp; Interface Tutor for this Board">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🔌" Foreground="#64FFDA" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="WIRING" FontWeight="Bold" FontSize="9" Foreground="#B2DFDB" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <!-- ACTIVE BOARD SUMMARY CARD -->
                                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,2,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DevBoardSummary}" Style="{StaticResource MonoSecondaryTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DevBoardStrappingNotes}" Style="{StaticResource MonoSecondaryTextStyle}" FontSize="8.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- DOCK & AUTO-WIRING CONTROLS -->
                                            <UniformGrid Columns="2" Margin="0,2,0,2">
                                                <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Margin="1"
                                                              IsChecked="{Binding IsDevBoardDocked, Mode=TwoWay}"
                                                              Content="DOCK / UNDOCK"
                                                              ToolTip="Toggle dev board docked on CAD viewport margin" />
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding WirePowerRailsCommand}"
                                                        Content="WIRE POWER"
                                                        ToolTip="Auto-wire VCC (5V/3.3V) and GND from MCU to breadboard power rails" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2" Margin="0,1,0,2">
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding WireSensorCommand}"
                                                        Content="WIRE SENSOR"
                                                        ToolTip="Auto-connect VCC, GND and GPIO to placed sensor or LED" />
                                                <Button Style="{StaticResource DockButtonStyle}" Margin="1"
                                                        Command="{Binding ClearDevBoardWiresCommand}"
                                                        Content="CLEAR WIRES"
                                                        ToolTip="Remove all jumper wires attached to the microcontroller" />
                                            </UniformGrid>
                                            <!-- CABLES & HARDWARE PROGRAMMER SUB-CARD -->
                                            <Border Background="{StaticResource PanelBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,5"
                                                    Margin="0,5,0,3">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="CABLES &amp; HARDWARE PROGRAMMER"
                                                                   Style="{StaticResource PanelHeaderTextStyle}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource AccentCyanBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border DockPanel.Dock="Right"
                                                                Background="#0F172A"
                                                                BorderBrush="{StaticResource AccentCyanBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                Padding="4,1">
                                                            <TextBlock Text="{Binding SelectedCableBadgeText}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="8"
                                                                       Foreground="{StaticResource AccentCyanBrush}" />
                                                        </Border>
                                                    </DockPanel>
                                                    <UniformGrid Columns="3" Margin="0,0,0,3">
                                                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Margin="1" Padding="4,4" FontSize="8.5"
                                                                      Background="{StaticResource ToolbarSurfaceBrush}"
                                                                      BorderBrush="{StaticResource BorderBrush}"
                                                                      IsChecked="{Binding IsTypeCCableSelected, Mode=OneWay}"
                                                                      Command="{Binding SelectUsbCableCommand}" CommandParameter="typec"
                                                                      Content="USB TYPE-C"
                                                                      ToolTip="USB Type-C 3.1 programmer cable (native Wemos S2 Mini)" />
                                                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Margin="1" Padding="4,4" FontSize="8.5"
                                                                      Background="{StaticResource ToolbarSurfaceBrush}"
                                                                      BorderBrush="{StaticResource BorderBrush}"
                                                                      IsChecked="{Binding IsTypeBCableSelected, Mode=OneWay}"
                                                                      Command="{Binding SelectUsbCableCommand}" CommandParameter="usbb"
                                                                      Content="USB TYPE-B"
                                                                      ToolTip="Standard USB-B Printer/ISP cable (native Arduino Uno &amp; Mega)" />
                                                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Margin="1" Padding="4,4" FontSize="8.5"
                                                                      Background="{StaticResource ToolbarSurfaceBrush}"
                                                                      BorderBrush="{StaticResource BorderBrush}"
                                                                      IsChecked="{Binding IsMicroUsbCableSelected, Mode=OneWay}"
                                                                      Command="{Binding SelectUsbCableCommand}" CommandParameter="micro"
                                                                      Content="MICRO-USB"
                                                                      ToolTip="Micro-USB high-speed UART cable (native ESP32 DevKit &amp; STM32)" />
                                                    </UniformGrid>
                                                    <Grid Margin="0,1,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Style="{StaticResource DockButtonStyle}"
                                                                Margin="1"
                                                                Command="{Binding ToggleUsbCableConnectionCommand}"
                                                                Content="{Binding ConnectCableButtonLabel}"
                                                                ToolTip="Plug or unplug the USB programmer cable on the 2D CAD canvas" />
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource DockButtonStyle}"
                                                                Margin="3,1,1,1"
                                                                Padding="8,4"
                                                                Background="#004D40"
                                                                BorderBrush="#00BFA5"
                                                                Foreground="#A7FFEB"
                                                                FontWeight="Bold"
                                                                Visibility="{Binding IsProgrammerCableConnected, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding OpenProgrammerUploadDialogCommand}"
                                                                Content="⬆ UPLOAD TO BOARD"
                                                                ToolTip="Analyze code and flash firmware onto the virtual/connected MCU" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding ConnectedBoardSummary}"
                                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                                               FontSize="8.2"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding CableCompatibilityNote}"
                                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                                               FontSize="8.2"
                                                               Margin="0,1,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding ProgrammerStatusText}"
                                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                                               FontSize="8.2"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource AccentCyanBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="* Click any MCU pin socket on CAD canvas, then click a breadboard tie point to route jumper wires."
                                                       Style="{StaticResource MonoSecondaryTextStyle}" FontSize="8.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="PART PALETTE"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,10,0,3" />
                                    <ListBox Style="{StaticResource WorkstationListBoxStyle}"
                                             ItemContainerStyle="{StaticResource PaletteListItemStyle}"
                                             ItemsSource="{Binding BuildPartOptions}"
                                             SelectedItem="{Binding SelectedPartOption, Mode=TwoWay}"
                                             Focusable="False"
                                             MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource ScenarioTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Hint}"
                                                               Style="{StaticResource ScenarioDetailTextStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 1: RESISTOR               -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsResistorSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="RESISTANCE VALUE (Ω)" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="Ω" Style="{StaticResource MonoSecondaryTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                     Text="{Binding NewPartValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Resistance in Ohms, e.g. 220, 330, 1K, 4K7, 10K, 100K, 1M." />
                                        </DockPanel>

                                        <!-- LIVE 4-BAND RESISTOR COLOUR CODE DISPLAY -->
                                        <Border Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,6,0,4" Padding="6,4">
                                            <StackPanel>
                                                <TextBlock Text="4-BAND EIA COLOUR CODE" Style="{StaticResource PanelHeaderTextStyle}" FontSize="9" Margin="0,0,0,4" />
                                                <Grid Height="14" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Grid.ColumnSpan="7" Background="#D9C79E" BorderBrush="#5A4D3B" BorderThickness="1" CornerRadius="3" />
                                                    <Border Grid.Column="1" Background="{Binding ResistorBand1Color}" Margin="2,0" />
                                                    <Border Grid.Column="2" Background="{Binding ResistorBand2Color}" Margin="2,0" />
                                                    <Border Grid.Column="3" Background="{Binding ResistorBand3Color}" Margin="2,0" />
                                                    <Border Grid.Column="5" Background="{Binding ResistorBand4Color}" Margin="2,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding ResistorBandDescription}" Style="{StaticResource MonoSecondaryTextStyle}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="COMMON E12 / E24 PRESETS" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <UniformGrid Columns="4" Margin="0,2,0,4">
                                            <Button Content="220 Ω" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="220R" ToolTip="LED current limiter on 5V" />
                                            <Button Content="330 Ω" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="330R" ToolTip="LED current limiter" />
                                            <Button Content="470 Ω" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="470R" />
                                            <Button Content="1 kΩ" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="1K" />
                                            <Button Content="2.2 kΩ" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="2K2" />
                                            <Button Content="4.7 kΩ" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="4K7" ToolTip="I2C pull-up" />
                                            <Button Content="10 kΩ" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="10K" ToolTip="Standard pull-up / pull-down" />
                                            <Button Content="100 kΩ" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetResistanceCommand}" CommandParameter="100K" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 2: CAPACITOR (FARADS)     -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsCapacitorSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="CAPACITANCE VALUE (FARADS)" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <DockPanel LastChildFill="True">
                                            <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                     Text="{Binding NewPartValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Capacitance value in Farads, e.g. 100pF, 10nF, 100nF, 1uF, 10uF, 100uF." />
                                        </DockPanel>

                                        <TextBlock Text="CERAMIC DISC (pF / nF — NON-POLARIZED)" Style="{StaticResource PanelHeaderTextStyle}" FontSize="9.5" Margin="0,6,0,3" Foreground="{StaticResource AccentBlueBrush}" />
                                        <UniformGrid Columns="4" Margin="0,1,0,4">
                                            <Button Content="100 pF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="100pF|Device/C" ToolTip="100 pF (101)" />
                                            <Button Content="1 nF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="1nF|Device/C" ToolTip="1 nF (102)" />
                                            <Button Content="10 nF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="10nF|Device/C" ToolTip="10 nF (103)" />
                                            <Button Content="100 nF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="100nF|Device/C" ToolTip="100 nF / 0.1 µF (104) Decoupling" />
                                        </UniformGrid>

                                        <TextBlock Text="ELECTROLYTIC CAN (µF — POLARIZED)" Style="{StaticResource PanelHeaderTextStyle}" FontSize="9.5" Margin="0,4,0,3" Foreground="#E68619" />
                                        <UniformGrid Columns="4" Margin="0,1,0,4">
                                            <Button Content="1 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="1uF|Device/C_Polarized" ToolTip="1 µF 50V Polarized" />
                                            <Button Content="10 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="10uF|Device/C_Polarized" ToolTip="10 µF 25V Polarized" />
                                            <Button Content="47 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="47uF|Device/C_Polarized" ToolTip="47 µF 25V Polarized" />
                                            <Button Content="100 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="100uF|Device/C_Polarized" ToolTip="100 µF 16V Polarized" />
                                            <Button Content="470 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="470uF|Device/C_Polarized" ToolTip="470 µF 16V Polarized" />
                                            <Button Content="1000 µF" Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetCapacitanceCommand}" CommandParameter="1000uF|Device/C_Polarized" ToolTip="1000 µF 16V Power Filter" />
                                        </UniformGrid>
                                        <TextBlock Text="* Electrolytic: Lead 1 is Anode (+), Lead 2 is Cathode (- stripe)." Style="{StaticResource MonoSecondaryTextStyle}" FontSize="9" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 3: IC TYPES               -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsIcSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="IC CLASSIFICATION &amp; CHIP TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  ToolTip="Choose from standard classified ICs (555 Timers, Op-Amps, 74xx Gates, Counters, Motor Drivers, MCUs)." />

                                        <TextBlock Text="DIP FOOTPRINT (PINS)" Style="{StaticResource StatusTextStyle}" Margin="0,6,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PinCountOptions}"
                                                  SelectedItem="{Binding SelectedPinCount, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  ToolTip="DIP packages straddle the central trench. Click pin 1 to place the entire footprint." />

                                        <TextBlock Text="IC PART NUMBER / LABEL" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                 Text="{Binding NewPartValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Printed chip name, e.g. NE555P, LM358, 74LS04, L293D." />

                                        <TextBlock Text="KICAD SYMBOL (OPTIONAL)" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                            <Button DockPanel.Dock="Right" Content="BROWSE" Style="{StaticResource DockButtonStyle}" Width="65" Margin="4,0,0,0" Command="{Binding BrowseNewPartSymbolCommand}" />
                                            <TextBox Style="{StaticResource DockTextBoxStyle}" Text="{Binding NewPartSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 4: JUMPER WIRE COLOURS    -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsJumperSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="JUMPER WIRE COLOUR" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ItemsControl ItemsSource="{Binding JumperColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="2"
                                                            Padding="4,5"
                                                            Style="{StaticResource DockButtonStyle}"
                                                            Command="{Binding DataContext.SelectJumperColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Code}"
                                                            ToolTip="{Binding Usage}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Border Width="10" Height="10" Background="{Binding HexColor}" BorderBrush="#555" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Selected wire color will be drawn accurately on the 2D canvas." Style="{StaticResource MonoSecondaryTextStyle}" FontSize="9.5" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 5: LED COLOUR             -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsLedSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="LED COLOUR &amp; FORWARD VOLTAGE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <UniformGrid Columns="2" Margin="0,2,0,4">
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="RED 2.0V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#FF1744" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="RED 2.0V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="GREEN 2.1V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#00E676" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="GREEN 2.1V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="BLUE 3.2V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#2979FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="BLUE 3.2V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="YELLOW 2.1V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#FFEA00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="YELLOW 2.1V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="WHITE 3.0V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="WHITE 3.0V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DockButtonStyle}" Margin="1" Command="{Binding SetLedColorCommand}" CommandParameter="ORANGE 2.0V">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="#FF9100" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="ORANGE 2.0V" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <TextBlock Text="* Polarity: Lead 1 is Anode (+ longer lead), Lead 2 is Cathode (- flat rim)." Style="{StaticResource MonoSecondaryTextStyle}" FontSize="9" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 6: BUTTON / SWITCH        -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsButtonSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="SWITCH TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 7: DIODE                  -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsDiodeSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="DIODE TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 8: TRANSISTOR             -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsTransistorSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="TRANSISTOR TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 9: POTENTIOMETER          -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsPotentiometerSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="POTENTIOMETER RESISTANCE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 10: VOLTAGE REGULATOR     -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsRegulatorSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="VOLTAGE REGULATOR" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 11: BUZZER                -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsBuzzerSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="BUZZER TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 12: SENSOR                -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsSensorSelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="SENSOR / MODULE TYPE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 12b: LCD / DISPLAY        -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsDisplaySelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="DISPLAY MODULE MODEL" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                        <TextBlock Text="* 4-Pin I2C Header: Pin 1=GND, Pin 2=VCC (+5V), Pin 3=SDA, Pin 4=SCL. Default Address 0x27."
                                                   Style="{StaticResource MonoSecondaryTextStyle}" FontSize="8.5" Margin="0,3,0,0" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <!-- CONTEXTUAL PANEL 13: BATTERY               -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding IsBatterySelected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="BATTERY / POWER SOURCE" Style="{StaticResource StatusTextStyle}" Margin="0,4,0,3" />
                                        <ComboBox Style="{StaticResource DockComboBoxStyle}"
                                                  ItemsSource="{Binding PartValuePresets}"
                                                  SelectedItem="{Binding SelectedPartValuePreset, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <!-- ========================================== -->
                                    <TextBlock Text="LEAD 1 / LEAD 2 (CLICK OR TYPE)"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,6,0,3" />
                                    <UniformGrid Columns="2">
                                        <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                 Margin="0,0,3,0"
                                                 ToolTip="A15, E20 or TOP_VCC_12. For a DIP this is pin 1."
                                                 Text="{Binding BuildPin1Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                 Margin="3,0,0,0"
                                                 ToolTip="D15, F20 or TOP_GND_25. Not used by a DIP/3-pin footprint."
                                                 Text="{Binding BuildPin2Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </UniformGrid>

                                    <Button Content="PLACE PART"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,4,0,0"
                                            Command="{Binding PlaceTypedPartCommand}" />

                                    <UniformGrid Columns="3" Margin="0,2,0,0">
                                        <Button Content="CANCEL"
                                                Style="{StaticResource DockButtonStyle}"
                                                ToolTip="Cancel the pending first lead."
                                                Command="{Binding CancelPendingLeadCommand}" />
                                        <Button Content="UNDO"
                                                Style="{StaticResource DockButtonStyle}"
                                                Command="{Binding UndoCircuitPartCommand}" />
                                        <Button Content="CLEAR"
                                                Style="{StaticResource DockButtonStyle}"
                                                Command="{Binding ClearCircuitCommand}" />
                                    </UniformGrid>

                                    <TextBlock Text="{Binding BuilderHint}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="PLACED PARTS" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,10">
                                    <Grid MinHeight="72">
                                        <ListBox Style="{StaticResource WorkstationListBoxStyle}"
                                                 ItemContainerStyle="{StaticResource DraftPartListItemStyle}"
                                                 ItemsSource="{Binding DraftParts}"
                                                 SelectedItem="{Binding SelectedDraftPart, Mode=TwoWay}"
                                                 MaxHeight="174">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Display}"
                                                                   Style="{StaticResource MonoTelemetryTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Style="{StaticResource ScenarioDetailTextStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SymbolNote}"
                                                                   Style="{StaticResource ScenarioDetailTextStyle}"
                                                                   FontSize="9"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="No parts yet. Pick a part above, then click lead 1 and lead 2 on the board."
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource MonoSecondaryTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DraftParts.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Text="SELECTED PART VALUE / SYMBOL"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,6,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             Text="{Binding EditPartValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Printed value of the selected part, e.g. 4K7 or NE555P." />
                                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right"
                                                Content="BROWSE"
                                                Style="{StaticResource DockButtonStyle}"
                                                Width="70"
                                                Margin="6,0,0,0"
                                                Command="{Binding BrowseEditPartSymbolCommand}" />
                                        <TextBox Style="{StaticResource DockTextBoxStyle}"
                                                 Text="{Binding EditPartSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="KiCad symbol of the selected part, e.g. Timer/NE555P." />
                                    </DockPanel>
                                    <Button Content="APPLY VALUE / SYMBOL"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            Command="{Binding ApplyPartEditsCommand}" />

                                    <UniformGrid Columns="1" Margin="0,4,0,0">
                                        <Button Content="REMOVE SELECTED"
                                                Style="{StaticResource DockButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding RemoveSelectedCircuitPartCommand}" />
                                        <Button Content="LOAD SELECTED DEMO"
                                                Style="{StaticResource DockButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2,0,0"
                                                ToolTip="Copies the scenario picked in the SCENE tab into the builder."
                                                Command="{Binding LoadExampleCircuitCommand}" />
                                    </UniformGrid>

                                    <Button Content="LOAD 555 EXAMPLE"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            ToolTip="Loads the reference NE555 astable, which passes every DRC rule."
                                            Command="{Binding Load555CircuitCommand}" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="RESOLVED NETLIST" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <TextBlock Text="{Binding NetlistText}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,8,12,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================== AI ROUTING ========================== -->
                    <TabItem Header="AI ROUTING" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="TUTOR ROUTING" Style="{StaticResource DockHeaderTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding RemoteRouteLabel}"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </DockPanel>
                                </Border>

                                <StackPanel Margin="12,10,12,8">
                                    <TextBlock Text="STEP 1 · CHOOSE WHERE QWEN RUNS"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,4" />
                                    <ListBox Style="{StaticResource WorkstationListBoxStyle}"
                                             ItemContainerStyle="{StaticResource RouteListItemStyle}"
                                             ItemsSource="{Binding AiRouteOptions}"
                                             SelectedValue="{Binding SelectedAiRoute, Mode=TwoWay}"
                                             SelectedValuePath="Method"
                                             Focusable="False"
                                             VirtualizingPanel.IsVirtualizing="False">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Width="7" Height="7"
                                                             VerticalAlignment="Top"
                                                             Margin="0,4,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Fill" Value="Transparent" />
                                                                <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                                                                <Setter Property="StrokeThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                                 Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}" />
                                                                        <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource ScenarioTitleTextStyle}" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding Badge}"
                                                                       Style="{StaticResource MonoSecondaryTextStyle}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Style="{StaticResource ScenarioDetailTextStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="{Binding SelectedAiRouteTitle}"
                                               Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <!-- LOCAL QWEN -->
                                <StackPanel Margin="12,8,12,14"
                                            Visibility="{Binding IsLocalQwenRoute, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="llama-server.exe runs on the RTX 3060 and streams Qwen3-VL tokens over loopback. Nothing leaves this PC."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <Button Content="USE LOCAL QWEN"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding UseLocalTutorCommand}"
                                            ToolTip="Clears any tunnel and sends the tutor back to llama-server on this PC." />

                                    <Border Style="{StaticResource DockSeparatorStyle}" Margin="0,10,0,8" />

                                    <TextBlock Text="ACTIVE TUTOR"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TutorBackend}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding VoiceBackend}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Only Qwen's answers are spoken. DRC faults stay in the right-hand list as text; the critical-short alarm is the only other sound."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- COLAB TUNNEL -->
                                <StackPanel Margin="12,8,12,14"
                                            Visibility="{Binding IsColabRoute, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Run the notebook, then paste the single BBAOI1|... line it prints in cell 5. The code is remembered for the next start."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <TextBlock Text="PAIR CODE"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             ToolTip="Run all in the Colab notebook, then paste the single BBAOI1|... line it prints."
                                             Text="{Binding PairCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <UniformGrid Columns="2" Margin="0,2,0,0">
                                        <Button Content="CONNECT"
                                                Style="{StaticResource DockButtonStyle}"
                                                ToolTip="Probes the tunnel and routes the tutor through Colab."
                                                Command="{Binding ConnectPairCodeCommand}" />
                                        <Button Content="DISCONNECT"
                                                Style="{StaticResource DockButtonStyle}"
                                                ToolTip="Forgets the tunnel and returns to local Qwen."
                                                Command="{Binding DisconnectPairCodeCommand}" />
                                    </UniformGrid>

                                    <Border Style="{StaticResource DockSeparatorStyle}" Margin="0,10,0,8" />

                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="GOOGLE DRIVE (OPTIONAL)"
                                                   Style="{StaticResource DockHeaderTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding GoogleAccountStatus}"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="Only needed if you want automatic tunnel discovery. The pair code above needs no Google account."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <TextBlock Text="OAUTH CLIENT ID (DESKTOP APP)"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             ToolTip="Google Cloud Console → APIs &amp; Services → Credentials → OAuth client ID → Desktop app."
                                             Text="{Binding GoogleClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="CLIENT SECRET (OPTIONAL)"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,6,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             Text="{Binding GoogleClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <UniformGrid Columns="2" Margin="0,2,0,0">
                                        <Button Content="LINK GOOGLE"
                                                Style="{StaticResource DockButtonStyle}"
                                                Command="{Binding LinkGoogleCommand}" />
                                        <Button Content="UNLINK"
                                                Style="{StaticResource DockButtonStyle}"
                                                Command="{Binding UnlinkGoogleCommand}" />
                                    </UniformGrid>

                                    <Button Content="PUBLISH SESSION"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            ToolTip="Writes a one-time session key to Drive for the Colab notebook."
                                            Command="{Binding PublishColabSessionCommand}" />
                                    <Button Content="OPEN NOTEBOOK"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            Command="{Binding OpenColabNotebookCommand}" />
                                    <Button Content="REFRESH ENDPOINT"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            Command="{Binding RefreshColabCommand}" />
                                    <ToggleButton Content="USE COLAB AI"
                                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                                  IsChecked="{Binding UseColabAi, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,8,0,0"
                                                  ToolTip="Keep polling Drive for a refreshed tunnel while the notebook runs." />
                                </StackPanel>

                                <!-- LOCAL PROVIDER -->
                                <StackPanel Margin="12,8,12,14"
                                            Visibility="{Binding IsLocalProviderRoute, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="No tunnel and no download: reuse a model that is already loaded in your own LM Studio or Ollama. Nothing is installed or started by this app."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <UniformGrid Columns="2">
                                        <Button Content="LM STUDIO"
                                                Style="{StaticResource DockButtonStyle}"
                                                ToolTip="Probes http://127.0.0.1:1234/v1/models"
                                                Command="{Binding ConnectLocalProviderCommand}"
                                                CommandParameter="lmstudio" />
                                        <Button Content="OLLAMA"
                                                Style="{StaticResource DockButtonStyle}"
                                                ToolTip="Probes http://127.0.0.1:11434/v1/models"
                                                Command="{Binding ConnectLocalProviderCommand}"
                                                CommandParameter="ollama" />
                                    </UniformGrid>

                                    <TextBlock Text="{Binding LocalProviderStatus}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="The provider must be running with a model loaded. Its own model name is discovered automatically."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- MANUAL ENDPOINT -->
                                <StackPanel Margin="12,8,12,14"
                                            Visibility="{Binding IsManualRoute, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="For an advanced tunnel or a provider that is not listed. Remote hosts must use https; plain http is accepted only for 127.0.0.1."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <TextBlock Text="TUNNEL URL"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             ToolTip="https://random-words.trycloudflare.com"
                                             Text="{Binding ManualEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="BEARER KEY"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,6,0,3" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             ToolTip="Bearer key printed by the notebook; leave blank if the endpoint has none."
                                             Text="{Binding ManualApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Content="APPLY MANUAL ENDPOINT"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2,0,0"
                                            Command="{Binding ApplyManualEndpointCommand}" />

                                    <TextBlock Text="A custom public domain asks for confirmation before any crop leaves this PC."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <StackPanel Margin="12,8,12,12">
                                    <TextBlock Text="LAST ACTION"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding RemoteAiStatus}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ CUSTOMIZE ============================ -->
                    <TabItem Header="CUSTOMIZE" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- SECTION 1: PERCEPTION PIPELINE -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="PERCEPTION PIPELINE (FAST REFLEX)" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <CheckBox Content="OpenCV Camera &amp; Homography Warping"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsOpenCvEnabled, Mode=TwoWay}"
                                              ToolTip="When disabled, skips camera grabbing and homography warping." />
                                    <TextBlock Text="Warps 1080p camera frames into normalized 1000x500 CAD coordinate space."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="YOLOv11s-Pose Keypoint Inference"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsYoloEnabled, Mode=TwoWay}"
                                              ToolTip="When disabled, skips ONNX Runtime GPU inference." />
                                    <TextBlock Text="Extracts component bounding boxes and Lead 1 / Lead 2 hole coordinates."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="Hand Motion Gate (Cv2.AbsDiff)"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsHandGateEnabled, Mode=TwoWay}"
                                              ToolTip="When disabled, does not wait for hands to clear the frame." />
                                    <TextBlock Text="Holds inspection until hands are removed and the breadboard is stable for 250 ms."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,4" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- SECTION 2: ELECTRICAL VERIFICATION -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="ELECTRICAL VERIFICATION &amp; DRC" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <CheckBox Content="KiCad ERC / DRC Engine"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsDrcEnabled, Mode=TwoWay}"
                                              ToolTip="When disabled, clears all DRC checks and netlist resolution." />
                                    <TextBlock Text="Union-Find jumper netlist resolution, direct short detection, and air-wire ratsnest."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,4" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- SECTION 3: COGNITIVE TUTOR (QWEN) -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="COGNITIVE TUTOR (QWEN MoE)" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <CheckBox Content="Enable Cognitive Tutor Loop"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsCognitiveTutorEnabled, Mode=TwoWay}"
                                              ToolTip="Dispatches changed board topology to the multimodal tutor loop." />
                                    <TextBlock Text="Streams explanations from Qwen3-VL-30B-A3B or the connected AI provider."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="Rule-Based Advice Fallback (When Qwen Offline)"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsRuleBasedAdviceEnabled, Mode=TwoWay}"
                                              ToolTip="When Qwen is offline, generate deterministic DRC repair guidance." />
                                    <TextBlock Text="When disabled and Qwen is offline, an explicit offline notice is displayed with zero hallucination."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,4" />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- SECTION 4: AUDIO & VOICE SYNTHESIS -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="AUDIO &amp; VOICE SYNTHESIS (BMO)" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <CheckBox Content="Voice Audio Output Enabled"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsVoiceEnabled, Mode=TwoWay}"
                                              ToolTip="Master toggle for spoken voice tutoring." />
                                    <TextBlock Text="Synthesizes tutor guidance aloud via Kokoro-82M, Piper, or Windows SAPI."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="Speak Rule-Based Advice When Qwen Offline"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding SpeakRuleBasedAdvice, Mode=TwoWay}"
                                              ToolTip="Allows the voice engine to speak deterministic DRC repair guidance." />
                                    <TextBlock Text="Enables spoken advice during local testing without requiring the GPU Qwen model to run."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="Emergency Short-Circuit Alarm (&lt;10ms)"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsAlarmEnabled, Mode=TwoWay}"
                                              ToolTip="Plays the hardware WAV alarm on critical VCC-GND shorts." />
                                    <TextBlock Text="Ultra-fast reflex audio alarm that bypasses the LLM to protect physical hardware."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,10" />

                                    <CheckBox Content="BMO Natural Voice Profiling &amp; Pauses"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsBmoVoiceStylingEnabled, Mode=TwoWay}"
                                              ToolTip="Natural conversational pacing, prosody pauses, and audio de-rumble." />
                                    <TextBlock Text="Shapes synthesis with natural prosody pauses, de-rumble, and conversational rate."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,12" />

                                    <Button Content="AUDITION VOICE (SPEAK SAMPLE)"
                                            Style="{StaticResource DockButtonStyle}"
                                            Command="{Binding TestVoiceCommand}"
                                            ToolTip="Plays a natural greeting line using the active voice backend." />
                                </StackPanel>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- SECTION 5: HARDWARE ISOLATION -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <TextBlock Text="HARDWARE &amp; AFFINITY" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <StackPanel Margin="12,8,12,14">
                                    <CheckBox Content="CPU Affinity Mask Pinning"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsAffinityEnabled, Mode=TwoWay}"
                                              ToolTip="Pins threads according to Intel Core i5-13600K hybrid core architecture." />
                                    <TextBlock Text="P-Cores (0x00FFF) for Qwen AVX2 &amp; TTS; E-Cores (0x3F000 / 0xC0000) for Vision &amp; DRC."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,4" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ VIEW ============================ -->
                    <TabItem Header="VIEW" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="WORKSPACE LAYOUT" Style="{StaticResource DockHeaderTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="AUTO-SAVED"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </DockPanel>
                                </Border>

                                <StackPanel Margin="12,8,12,12">
                                    <TextBlock Text="PRESETS"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,0,0,3" />

                                    <UniformGrid Columns="2">
                                        <Button Content="WORKSTATION"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="0,0,3,2"
                                                Command="{Binding ApplyLayoutPresetCommand}"
                                                CommandParameter="workstation"
                                                ToolTip="SCENE dock on the left, DRC tutor on the right, default widths." />
                                        <Button Content="WIDE CANVAS"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="3,0,0,2"
                                                Command="{Binding ApplyLayoutPresetCommand}"
                                                CommandParameter="canvas"
                                                ToolTip="Hide both docks so the CAD viewport uses the full window." />
                                        <Button Content="INSPECT FOCUS"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="0,2,3,0"
                                                Command="{Binding ApplyLayoutPresetCommand}"
                                                CommandParameter="inspect"
                                                ToolTip="Hide the left dock and keep the DRC / tutor dock." />
                                        <Button Content="BUILDER FOCUS"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="3,2,0,0"
                                                Command="{Binding ApplyLayoutPresetCommand}"
                                                CommandParameter="builder"
                                                ToolTip="Open the BUILDER dock and hide the DRC dock." />
                                    </UniformGrid>

                                    <TextBlock Text="PANELS"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,12,0,3" />
                                    <CheckBox Content="LEFT DOCK"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsLeftDockVisible, Mode=TwoWay}" />
                                    <TextBlock Text="SCENE / BUILDER / AI ROUTING / VIEW"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               Margin="19,0,0,5"
                                               TextWrapping="Wrap" />
                                    <CheckBox Content="RIGHT DOCK"
                                              Style="{StaticResource LayerCheckBoxStyle}"
                                              IsChecked="{Binding IsRightDockVisible, Mode=TwoWay}" />
                                    <TextBlock Text="DRC / PIN INSPECTOR / QWEN"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               Margin="19,0,0,5"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="DOCK WIDTHS"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,12,0,4" />

                                    <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                        <TextBlock Text="LEFT DOCK" Style="{StaticResource MonoSecondaryTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding LeftDockWidth, StringFormat={}{0:F0} PX}"
                                                   Style="{StaticResource MonoSecondaryTextStyle}" />
                                    </DockPanel>
                                    <Slider Minimum="200" Maximum="460"
                                            Style="{StaticResource DockSliderStyle}"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding LeftDockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Drag to resize the left dock. The value is remembered." />

                                    <DockPanel LastChildFill="False" Margin="0,8,0,1">
                                        <TextBlock Text="RIGHT DOCK" Style="{StaticResource MonoSecondaryTextStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding RightDockWidth, StringFormat={}{0:F0} PX}"
                                                   Style="{StaticResource MonoSecondaryTextStyle}" />
                                    </DockPanel>
                                    <Slider Minimum="240" Maximum="520"
                                            Style="{StaticResource DockSliderStyle}"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding RightDockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Drag to resize the right dock. The value is remembered." />

                                    <Button Content="RESET LAYOUT"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,12,0,0"
                                            Command="{Binding ResetLayoutCommand}"
                                            ToolTip="Restore the default workstation widths and show both docks." />

                                    <TextBlock Text="AI VOICE (QWEN ANSWERS ONLY)"
                                               Style="{StaticResource StatusTextStyle}"
                                               Margin="0,14,0,4" />
                                    <UniformGrid Columns="2">
                                        <Button Content="AUTO"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="0,0,3,2"
                                                Command="{Binding SelectVoiceEngineCommand}"
                                                CommandParameter="auto"
                                                ToolTip="Prefer Piper, then Kokoro, then Windows SAPI." />
                                        <Button Content="PIPER"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="3,0,0,2"
                                                Command="{Binding SelectVoiceEngineCommand}"
                                                CommandParameter="piper"
                                                ToolTip="Use the Piper voice in assets/models/piper (bmo.onnx). No pitch processing." />
                                        <Button Content="KOKORO"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="0,2,3,0"
                                                Command="{Binding SelectVoiceEngineCommand}"
                                                CommandParameter="kokoro"
                                                ToolTip="Use Kokoro-82M with a natural adult voice." />
                                        <Button Content="SAPI"
                                                Style="{StaticResource DockButtonStyle}"
                                                Margin="3,2,0,0"
                                                Command="{Binding SelectVoiceEngineCommand}"
                                                CommandParameter="sapi"
                                                ToolTip="Use the most natural installed Windows voice." />
                                    </UniformGrid>
                                    <Button Content="TEST VOICE"
                                            Style="{StaticResource DockButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0"
                                            Command="{Binding TestVoiceCommand}"
                                            ToolTip="Speak a short natural test line with the active engine." />

                                    <TextBlock Text="{Binding VoiceBackend}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding VoiceSetupNote}"
                                               ToolTip="{Binding VoiceSetupNote}"
                                               MaxHeight="46"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource MonoSecondaryTextStyle}">
                                                <Setter Property="Foreground" Value="{StaticResource DrcWarningBrush}" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VoiceSetupNote}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Only Qwen's own answers are spoken. DRC faults stay in the right-hand list as text. If the model is offline the explanation is text-only and nothing is spoken."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />

                                    <TextBlock Text="Presets, panel visibility and widths are saved automatically to %LOCALAPPDATA%\BreadboardAOI\workspace-layout.json. Click a tab above to choose which tool dock is active."
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ============================ WIRING ============================ -->
                    <TabItem Header="WIRING" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- Dock Top Control Bar -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="🔌 WIRING GUIDE &amp; TUTOR" Style="{StaticResource DockHeaderTextStyle}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right"
                                                Content="✕ CLOSE"
                                                Style="{StaticResource DockButtonStyle}"
                                                Height="20" Padding="6,1"
                                                Command="{Binding CloseWiringGuideDockCommand}"
                                                ToolTip="Close the Left Panel Wiring Guide dock" />
                                        <Button DockPanel.Dock="Right"
                                                Content="↗ POPUP"
                                                Style="{StaticResource DockButtonStyle}"
                                                Height="20" Padding="6,1" Margin="0,0,4,0"
                                                Command="{Binding UndockWiringGuideToPopupCommand}"
                                                ToolTip="Restore Wiring Guide Studio as a standalone floating window" />
                                    </DockPanel>
                                </Border>

                                <!-- Board & Sensor Selection Controls -->
                                <Border Background="#161822" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="4" Margin="10,8,10,6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="TARGET DEV BOARD" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding AvailableDockedBoards}"
                                                  SelectedItem="{Binding SelectedDockedBoard, Mode=TwoWay}"
                                                  Background="#232634" Foreground="#FFFFFF" BorderBrush="#4B5563"
                                                  Margin="0,0,0,8" Padding="6,3" />

                                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                            <TextBlock Text="ACTIVE SENSOR" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right"
                                                    Content="✨ AUTO-DETECT"
                                                    Style="{StaticResource DockButtonStyle}"
                                                    Height="18" Padding="6,0"
                                                    Command="{Binding AutoDetectDockedSensorCommand}"
                                                    ToolTip="Auto-detect sensor breakout placed in current breadboard draft" />
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding DockedSensors}"
                                                  SelectedItem="{Binding SelectedDockedSensor, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  Background="#232634" Foreground="#FFFFFF" BorderBrush="#4B5563"
                                                  Padding="6,3" />
                                    </StackPanel>
                                </Border>

                                <!-- Sensor Overview Card -->
                                <Border Background="#151722" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="4" Margin="10,4,10,6" Padding="10,8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DockedWiringGuide.Sensor.DisplayName}"
                                                       FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding DockedWiringGuide.Sensor.Protocol}"
                                                           FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                            </Border>
                                        </DockPanel>

                                        <TextBlock Text="{Binding DockedWiringGuide.Sensor.Summary}"
                                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6" />

                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="OPERATING VOLTAGE:" Style="{StaticResource StatusTextStyle}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding DockedWiringGuide.Sensor.OperatingVoltage}"
                                                       FontWeight="Bold" FontSize="10" Foreground="#34D399" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Level-Shifting / Voltage Warning Card (if required) -->
                                <Border Background="#2B1D0E" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4"
                                        Margin="10,4,10,6" Padding="10,8"
                                        Visibility="{Binding DockedWiringGuide.IsLevelShiftingRequired, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="VOLTAGE LEVEL COMPATIBILITY WARNING" FontWeight="Bold" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DockedWiringGuide.LevelShiftingAdvice}"
                                                   Foreground="#FDE68A" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Step-by-Step Connection Table -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}" Margin="0,6,0,0">
                                    <TextBlock Text="CONNECTION &amp; JUMPER WIRE MAP" Style="{StaticResource DockHeaderTextStyle}" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding DockedWiringGuide.Steps}" Margin="10,4,10,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#181A26" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Pin Number Circle -->
                                                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                            Width="22" Height="22" CornerRadius="11"
                                                            Background="#2A2D3D" Margin="0,0,8,0"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SensorPinNumber}"
                                                                   FontWeight="Bold" FontSize="10" Foreground="#E2E8F0"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Sensor Pin -> Dev Board Pin -->
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SensorPinName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                                        <TextBlock Text=" ➔ " Foreground="#94A3B8" FontSize="12" />
                                                        <TextBlock Text="{Binding TargetBoardPin}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                                    </StackPanel>

                                                    <!-- Wire Color Pill -->
                                                    <Border Grid.Row="0" Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WireColor}" FontWeight="Bold" FontSize="9" Foreground="{Binding WireColorHex}" />
                                                    </Border>

                                                    <!-- Connection Explanation -->
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                               Text="{Binding Explanation}"
                                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />

                                                    <!-- Inline Warning Badge (if present) -->
                                                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                            Background="#3B1212" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3"
                                                            Margin="0,4,0,0" Padding="6,3"
                                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Warning}"
                                                                   Foreground="#FCA5A5" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Verification Firmware Card -->
                                <Border Style="{StaticResource DockHeaderBorderStyle}" Margin="0,6,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="TEST FIRMWARE (ARDUINO / C++)" Style="{StaticResource DockHeaderTextStyle}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right"
                                                Content="📋 COPY CODE"
                                                Style="{StaticResource DockButtonStyle}"
                                                Height="20" Padding="8,1"
                                                Command="{Binding CopyDockedCodeCommand}"
                                                ToolTip="Copy verification test code to clipboard" />
                                    </DockPanel>
                                </Border>

                                <Border Background="#0D0F17" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="4" Margin="10,6,10,6" Padding="8">
                                    <TextBlock Text="{Binding DockedWiringGuide.Sensor.MinimalTestCodeIno}"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               FontSize="10" Foreground="#A7F3D0" TextWrapping="Wrap" MaxHeight="160" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="LAB (EXP)" Style="{StaticResource DockTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <!-- EXPERIMENTAL LAB BANNER -->
                                <Border Background="#161B26" BorderBrush="#2A364F" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="EXPERIMENTAL WORKBENCH &amp; LIVE MCU LAB"
                                                   Style="{StaticResource PanelHeaderTextStyle}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource AccentCyanBrush}" />
                                        <TextBlock Text="{Binding ExperimentalLabStatus}"
                                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                                   FontSize="9"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 1. CIRCUIT DRC AUTO-FIX -->
                                <TextBlock Text="CIRCUIT DRC AUTO-FIX" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,2,0,4" />
                                <Button Style="{StaticResource DockButtonStyle}"
                                        Command="{Binding AutoFixAllViolationsCommand}"
                                        Background="#1B3B2B"
                                        BorderBrush="#10B981"
                                        Foreground="#A7F3D0"
                                        FontWeight="Bold"
                                        Padding="8,6"
                                        Content="✨ AUTO-FIX ALL DRC VIOLATIONS"
                                        ToolTip="Automatically resolve VCC-GND rail shorts, add 220R resistors on bare LEDs, fix reversed LED polarity, and align floating pins" />
                                <TextBlock Text="Fixes rail shorts, inserts missing 220R LED limiters, flips reversed LED leads, and resolves floating junctions."
                                           Style="{StaticResource MonoSecondaryTextStyle}"
                                           FontSize="8.5"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" />

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- 2. AI PROMPT TO CIRCUIT SYNTHESIZER -->
                                <TextBlock Text="NATURAL LANGUAGE CIRCUIT SYNTHESIZER" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,6,0,4" />
                                <TextBox Style="{StaticResource DockTextBoxStyle}"
                                         Text="{Binding ExperimentalCircuitPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,0,0,4"
                                         ToolTip="Describe a circuit e.g. 'LED blink with 220R resistor' or 'Ultrasonic distance radar with buzzer'" />
                                <Button Style="{StaticResource DockButtonStyle}"
                                        Command="{Binding GenerateCircuitFromPromptCommand}"
                                        Background="#1E293B"
                                        BorderBrush="{StaticResource AccentBlueBrush}"
                                        Foreground="#E2E8F0"
                                        FontWeight="SemiBold"
                                        Padding="8,5"
                                        Content="⚡ GENERATE CIRCUIT &amp; CODE" />
                                <ItemsControl ItemsSource="{Binding PresetCircuitPrompts}" Margin="0,5,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Style="{StaticResource DockButtonStyle}"
                                                    FontSize="8.5"
                                                    Padding="6,3"
                                                    Margin="0,0,4,4"
                                                    Command="{Binding DataContext.GenerateCircuitFromPromptCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- 3. THERMAL & CURRENT HEATMAP -->
                                <TextBlock Text="THERMAL / CURRENT IR HEATMAP" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,6,0,4" />
                                <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                              Background="{StaticResource ToolbarSurfaceBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              IsChecked="{Binding ShowThermalHeatmap, Mode=TwoWay}"
                                              Content="🔥 SHOW THERMAL HEATMAP OVERLAY"
                                              ToolTip="Render calibrated power dissipation (mW / mA) heatmap halos across placed components" />
                                <TextBlock Text="{Binding ThermalSummaryText}"
                                           Style="{StaticResource MonoSecondaryTextStyle}"
                                           FontSize="9"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource DrcWarningBrush}" />

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- 4. FIRMWARE SIMULATOR & SERIAL MONITOR -->
                                <DockPanel LastChildFill="False" Margin="0,6,0,4">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="VIRTUAL FIRMWARE &amp; SERIAL (115200)"
                                               Style="{StaticResource PanelHeaderTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding FirmwareStatusBadge}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="8.5"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox Content="Show 2D Hardware Programmer on CAD Canvas"
                                          Style="{StaticResource LayerCheckBoxStyle}"
                                          IsChecked="{Binding ShowHardwareProgrammer, Mode=TwoWay}"
                                          Margin="0,0,0,4" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Style="{StaticResource DockButtonStyle}" Margin="1" FontSize="8.5"
                                            Command="{Binding ConnectUsbCableCommand}"
                                            Content="🔌 CONNECT USB" />
                                    <Button Style="{StaticResource DockButtonStyle}" Margin="1" FontSize="8.5"
                                            Background="#004D40" BorderBrush="#00897B" Foreground="#A7FFEB"
                                            Command="{Binding OpenProgrammerUploadDialogCommand}"
                                            Content="⬆ UPLOAD FW" />
                                    <Button Style="{StaticResource DockButtonStyle}" Margin="1" FontSize="8.5"
                                            Command="{Binding StopVirtualFirmwareCommand}"
                                            Content="⏹ STOP FW" />
                                </UniformGrid>
                                <TextBox Style="{StaticResource ConsoleTextBoxStyle}"
                                         Text="{Binding VirtualSerialLog, Mode=OneWay}"
                                         Height="116"
                                         FontSize="9"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource DockTextBoxStyle}"
                                             Text="{Binding SerialInputCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24"
                                             ToolTip="Send simulated serial input command to firmware" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource DockButtonStyle}"
                                            Margin="4,0,2,0"
                                            Padding="8,2"
                                            Command="{Binding SendSerialInputCommand}"
                                            Content="SEND" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource DockButtonStyle}"
                                            Margin="2,0,0,0"
                                            Padding="6,2"
                                            Command="{Binding ClearSerialMonitorCommand}"
                                            Content="CLR" />
                                </Grid>

                                <Border Style="{StaticResource DockSeparatorStyle}" />

                                <!-- 5. VIRTUAL LOGIC & PWM OSCILLOSCOPE -->
                                <TextBlock Text="VIRTUAL LOGIC &amp; PWM OSCILLOSCOPE" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,6,0,4" />
                                <Border Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="3" Padding="4" Height="66">
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="220" Height="56" Background="#070B12">
                                            <Line X1="0" Y1="28" X2="220" Y2="28" Stroke="#1E293B" StrokeThickness="0.7" StrokeDashArray="3 3" />
                                            <Line X1="55" Y1="0" X2="55" Y2="56" Stroke="#1E293B" StrokeThickness="0.7" StrokeDashArray="2 3" />
                                            <Line X1="110" Y1="0" X2="110" Y2="56" Stroke="#1E293B" StrokeThickness="0.7" StrokeDashArray="2 3" />
                                            <Line X1="165" Y1="0" X2="165" Y2="56" Stroke="#1E293B" StrokeThickness="0.7" StrokeDashArray="2 3" />
                                            <Polyline Points="{Binding OscilloscopeWaveformPoints}"
                                                      Stroke="#00E5FF"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ItemsControl ItemsSource="{Binding OscilloscopeSamples}" Margin="0,4,0,0" Height="18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#10B981" Margin="1,3" Opacity="0.75"
                                                    ToolTip="{Binding ChannelName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding OscilloscopeSummaryText}"
                                           Style="{StaticResource MonoSecondaryTextStyle}"
                                           FontSize="8.5"
                                           Margin="0,3,0,2"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentCyanBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- CENTRE CAD VIEWPORT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DockHeaderBorderStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding ViewportTitle}"
                                   Style="{StaticResource DockHeaderTextStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding HoverHoleId, StringFormat=PIN {0}}"
                                   Style="{StaticResource MonoSecondaryTextStyle}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PasteboardBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <skia:SKElement x:Name="Viewport"
                                        PaintSurface="OnViewportPaintSurface"
                                        MouseMove="OnViewportMouseMove"
                                        MouseLeave="OnViewportMouseLeave"
                                        MouseDown="OnViewportMouseDown"
                                        MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
                                        MouseRightButtonDown="OnViewportMouseRightButtonDown"
                                        MouseUp="OnViewportMouseUp"
                                        MouseWheel="OnViewportMouseWheel"
                                        AllowDrop="True"
                                        DragOver="OnViewportDragOver"
                                        Drop="OnViewportDrop" />
                        <!-- FLOATING 2.5D CAD VIEWPORT ZOOM TOOLBAR -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16" Background="#EE161920"
                                CornerRadius="5" BorderBrush="#3B4252" BorderThickness="1"
                                Padding="5,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Command="{Binding ZoomOutCommand}" Width="28" Height="26"
                                        ToolTip="Zoom Out (Ctrl+Minus / Wheel Down)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="13" Cursor="Hand" />
                                <TextBlock Text="{Binding ViewportZoomText}" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="#88C0D0" FontWeight="Bold" FontSize="11" FontFamily="Consolas"
                                           MinWidth="38" TextAlignment="Center" ToolTip="Current Viewport Zoom" />
                                <Button Content="+" Command="{Binding ZoomInCommand}" Width="28" Height="26"
                                        ToolTip="Zoom In (Ctrl+Plus / Wheel Up)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="13" Cursor="Hand" />
                                <Button Content="FIT" Command="{Binding ResetZoomCommand}" Width="38" Height="26" Margin="4,0,0,0"
                                        ToolTip="Reset Zoom 100% (Ctrl+0)"
                                        Background="#2E3440" Foreground="#A3BE8C" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="10" Cursor="Hand" />
                                <Border Width="1" Background="#434C5E" Margin="6,2" />
                                <Button Content="◄" Command="{Binding PanLeftCommand}" Width="26" Height="26"
                                        ToolTip="Pan Viewport Left (Arrow Left / A)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                <Button Content="▲" Command="{Binding PanUpCommand}" Width="26" Height="26" Margin="2,0,0,0"
                                        ToolTip="Pan Viewport Up (Arrow Up / W)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                <Button Content="▼" Command="{Binding PanDownCommand}" Width="26" Height="26" Margin="2,0,0,0"
                                        ToolTip="Pan Viewport Down (Arrow Down / S)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                <Button Content="►" Command="{Binding PanRightCommand}" Width="26" Height="26" Margin="2,0,0,0"
                                        ToolTip="Pan Viewport Right (Arrow Right / D)"
                                        Background="#252A34" Foreground="#ECEFF4" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                <Button Content="⌖" Command="{Binding ResetPanCommand}" Width="26" Height="26" Margin="3,0,0,0"
                                        ToolTip="Center Viewport (Reset Pan)"
                                        Background="#2E3440" Foreground="#88C0D0" BorderBrush="#434C5E"
                                        FontWeight="Bold" FontSize="12" Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT DOCK -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsRightDockVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DockHeaderBorderStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="DRC VIOLATIONS" Style="{StaticResource DockHeaderTextStyle}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ViolationSummary}"
                                       Style="{StaticResource MonoSecondaryTextStyle}" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox Style="{StaticResource WorkstationListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DrcListItemStyle}"
                                 ItemsSource="{Binding Violations}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource SeverityChipStyle}">
                                                        <Setter Property="Background" Value="#33E68619" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DrcWarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                <Setter Property="Background" Value="#33D7373F" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource DrcCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SeverityLabel}" FontFamily="{StaticResource UiFontFamily}" FontSize="9" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{StaticResource DrcWarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DrcCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding CodeLabel}"
                                                       Style="{StaticResource MonoTelemetryTextStyle}"
                                                       VerticalAlignment="Top" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding BadHole}" Style="{StaticResource MonoSecondaryTextStyle}" />
                                            <TextBlock Text="  →  " Style="{StaticResource MonoSecondaryTextStyle}"
                                                       Visibility="{Binding HasCorrection, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TargetHole}" Style="{StaticResource MonoSecondaryTextStyle}"
                                                       Visibility="{Binding HasCorrection, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Message}"
                                                   FontFamily="{StaticResource UiFontFamily}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="NO VIOLATIONS — NETLIST CLEAN"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Violations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource DockSeparatorStyle}" />

                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource DockHeaderBorderStyle}">
                            <TextBlock Text="PIN INSPECTOR" Style="{StaticResource DockHeaderTextStyle}" />
                        </Border>

                        <Grid Margin="12,8,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="HOLE" Style="{StaticResource InspectorLabelStyle}" Margin="0,0,6,1" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HoverHoleId}" Style="{StaticResource InspectorValueStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="STRIP" Style="{StaticResource InspectorLabelStyle}" Margin="0,0,6,1" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding HoverStripId}" Style="{StaticResource InspectorValueStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NET" Style="{StaticResource InspectorLabelStyle}" Margin="0,0,6,1" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding HoverNetName}" Style="{StaticResource InspectorValueStyle}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TYPE" Style="{StaticResource InspectorLabelStyle}" Margin="0,0,6,1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HoverStripType}" Style="{StaticResource InspectorValueStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="LEADS" Style="{StaticResource InspectorLabelStyle}" Margin="0,0,6,1" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding HoverOccupancy}" Style="{StaticResource InspectorValueStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="4" Style="{StaticResource DockSeparatorStyle}" />
                    <!-- ========================================================
                         ZONE 2D — AVOMETER (DIGITAL MULTIMETER)
                         ======================================================== -->
                    <StackPanel Grid.Row="5">
                        <Border Style="{StaticResource DockHeaderBorderStyle}">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvometerActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource LedOnlineBrush}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="DIGITAL AVOmeter" Style="{StaticResource DockHeaderTextStyle}" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="ACTIVE"
                                          Style="{StaticResource LayerCheckBoxStyle}"
                                          IsChecked="{Binding IsAvometerActive, Mode=TwoWay}"
                                          ToolTip="Toggle AVOmeter needle probes display and simulation on breadboard." />
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="10,6,10,8">
                            <!-- Digital LCD Bezel Screen -->
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <StackPanel>
                                    <!-- LCD Header / Annunciator Bar -->
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding AvometerStatus}"
                                                   Style="{StaticResource StatusTextStyle}"
                                                   FontSize="8.5"
                                                   Foreground="#88C0D0" />
                                        <Border DockPanel.Dock="Right"
                                                Background="#D7373F"
                                                CornerRadius="2"
                                                Padding="4,1"
                                                Visibility="{Binding IsContinuityBeep, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="BEEP 🔊"
                                                       FontFamily="{StaticResource UiFontFamily}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </DockPanel>
                                    <!-- Main Digital Value & Unit -->
                                    <DockPanel Margin="0,3,0,1" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding AvometerUnit}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#88C0D0"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2" />
                                        <TextBlock Text="{Binding AvometerDisplayValue}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="#38BDF8"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- Secondary Diagnostic Reading -->
                                    <TextBlock Text="{Binding AvometerSecondaryReading}"
                                               Style="{StaticResource MonoSecondaryTextStyle}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,3" />
                                    <!-- Analog Bargraph -->
                                    <ProgressBar Value="{Binding AvometerBarPercent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Height="4"
                                                 Margin="0,4,0,2"
                                                 Background="#16202A"
                                                 Foreground="#2D9D78"
                                                 BorderThickness="0" />
                                </StackPanel>
                            </Border>
                            <!-- Mode Selector Buttons -->
                            <UniformGrid Columns="4" Margin="0,6,0,4">
                                <Button Content="V DC"
                                        Style="{StaticResource DockButtonStyle}"
                                        Margin="1"
                                        Command="{Binding SetAvometerModeCommand}"
                                        CommandParameter="V_DC"
                                        ToolTip="DC Voltage Measurement" />
                                <Button Content="OHMS (&#x3A9;)"
                                        Style="{StaticResource DockButtonStyle}"
                                        Margin="1"
                                        Command="{Binding SetAvometerModeCommand}"
                                        CommandParameter="OHMS"
                                        ToolTip="Resistance / Ohmmeter" />
                                <Button Content="CONT"
                                        Style="{StaticResource DockButtonStyle}"
                                        Margin="1"
                                        Command="{Binding SetAvometerModeCommand}"
                                        CommandParameter="CONT"
                                        ToolTip="Continuity Beeper (&lt; 10 &#x3A9;)" />
                                <Button Content="mA CURR"
                                        Style="{StaticResource DockButtonStyle}"
                                        Margin="1"
                                        Command="{Binding SetAvometerModeCommand}"
                                        CommandParameter="I_MA"
                                        ToolTip="DC Current (mA)" />
                            </UniformGrid>
                            <!-- Test Probe Leads Setup -->
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- COM Probe (Black) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="COM [-] (BLACK PROBE)" Style="{StaticResource PanelHeaderTextStyle}" FontSize="8.5" Foreground="#888888" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             Text="{Binding AvometerBlackHole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="COM hole coordinate (e.g. BOT_GND_1, E15, J20)" />
                                </StackPanel>
                                <!-- Positive Probe (Red) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="V/&#x3A9;/mA [+] (RED PROBE)" Style="{StaticResource PanelHeaderTextStyle}" FontSize="8.5" Foreground="#E05050" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource DockTextBoxStyle}"
                                             Text="{Binding AvometerRedHole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="V/&#x3A9; hole coordinate (e.g. TOP_VCC_1, A15, F20)" />
                                </StackPanel>
                            </Grid>
                            <!-- Quick Probe Actions -->
                            <UniformGrid Columns="4" Margin="0,1,0,0">
                                <Button Content="RAILS" Style="{StaticResource DockButtonStyle}" Margin="1"
                                        Command="{Binding MeasurePowerRailsCommand}"
                                        ToolTip="Attach probes to main power rails (GND &amp; VCC)" />
                                <Button Content="PART" Style="{StaticResource DockButtonStyle}" Margin="1"
                                        Command="{Binding AttachAvometerToSelectedPartCommand}"
                                        ToolTip="Attach probes across selected component in PLACED PARTS" />
                                <Button Content="SWAP" Style="{StaticResource DockButtonStyle}" Margin="1"
                                        Command="{Binding SwapAvometerProbesCommand}"
                                        ToolTip="Swap Red and Black probe leads" />
                                <Button Content="CLEAR" Style="{StaticResource DockButtonStyle}" Margin="1"
                                        Command="{Binding ClearAvometerProbesCommand}"
                                        ToolTip="Remove multimeter probes from breadboard" />
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="6" Style="{StaticResource DockSeparatorStyle}" />
                    <Grid Grid.Row="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DockHeaderBorderStyle}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="QWEN EXPLANATION"
                                           Style="{StaticResource DockHeaderTextStyle}" />
                                <Button DockPanel.Dock="Right"
                                        Content="ASK AI"
                                        Style="{StaticResource DockButtonStyle}"
                                        Height="20"
                                        Padding="8,1"
                                        Margin="8,0,0,0"
                                        Command="{Binding AskAiCommand}"
                                        ToolTip="Request an immediate Qwen AI multimodal diagnostic for the active board state." />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DrcStatus}"
                                           Style="{StaticResource MonoSecondaryTextStyle}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="{Binding TutorBackend}"
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="12,6,12,2" />

                        <TextBlock Grid.Row="2" Text="{Binding TutorLatency}"
                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0,12,4" />

                        <TextBox Grid.Row="3" x:Name="TranscriptBox"
                                 Style="{StaticResource ConsoleTextBoxStyle}"
                                 Margin="12,0,12,12"
                                 Text="{Binding TutorTranscript, Mode=OneWay}"
                                 TextChanged="OnTranscriptTextChanged" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================
             ZONE 3 — STATUS BAR
             ================================================================ -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="READY"
                           Style="{StaticResource StatusTextStyle}"
                           Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding FrameTelemetry}"
                           Style="{StaticResource MonoSecondaryTextStyle}" />
                <TextBlock Text="{Binding StatusLine}"
                           Style="{StaticResource StatusTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
