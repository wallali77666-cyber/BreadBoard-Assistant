<Window x:Class="BreadboardAOI.App.Views.ProgrammerUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HARDWARE PROGRAMMER &amp; FIRMWARE UPLOAD STUDIO"
        Width="780"
        Height="680"
        MinWidth="640"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PasteboardBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="11">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BreadboardAOI.App;component/Themes/SpectrumDarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER BANNER -->
            <Border Grid.Row="0" Background="{StaticResource ToolbarSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="USB-ISP / UART HARDWARE PROGRAMMER"
                                   Style="{StaticResource PanelHeaderTextStyle}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock x:Name="BoardSummaryText"
                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Right"
                            x:Name="CompatibilityBadgeBorder"
                            Background="#102A2E"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CompatibilityBadgeText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#64FFDA" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- HARDWARE PORT & CABLE CONFIGURATION -->
            <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="TARGET PORT / EXECUTION TARGET" Style="{StaticResource PanelHeaderTextStyle}" FontSize="9.5" Margin="0,0,0,4" />
                        <ComboBox x:Name="PortComboBox"
                                  Style="{StaticResource DockComboBoxStyle}"
                                  Height="26"
                                  SelectionChanged="OnPortSelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="TARGET FIRMWARE LANGUAGE &amp; CABLE" Style="{StaticResource PanelHeaderTextStyle}" FontSize="9.5" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LanguageComboBox"
                                      Grid.Column="0"
                                      Style="{StaticResource DockComboBoxStyle}"
                                      Height="26"
                                      SelectionChanged="OnLanguageSelectionChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="USB-C" Style="{StaticResource DockButtonStyle}" Padding="7,4" Margin="0,0,2,0" Click="OnSelectUsbCClick" />
                                <Button Content="USB-B" Style="{StaticResource DockButtonStyle}" Padding="7,4" Margin="0,0,2,0" Click="OnSelectUsbBClick" />
                                <Button Content="MICRO" Style="{StaticResource DockButtonStyle}" Padding="7,4" Click="OnSelectMicroUsbClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="PortDetailText"
                               Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Style="{StaticResource MonoSecondaryTextStyle}"
                               FontSize="9.5"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- PRE-FLIGHT DIAGNOSTICS BAR -->
            <Border Grid.Row="2" Background="{StaticResource EditorBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock x:Name="DiagnosticsHeaderText"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource MonoTelemetryTextStyle}"
                                   FontWeight="Bold"
                                   FontSize="10" />
                        <TextBlock x:Name="CodeStatsText"
                                   DockPanel.Dock="Right"
                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                   FontSize="9.5" />
                    </DockPanel>
                    <ListBox x:Name="DiagnosticsListBox"
                             MaxHeight="78"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplaySummary}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- FIRMWARE SOURCE EDITOR -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="FIRMWARE SKETCH / SCRIPT PAYLOAD (EDITABLE PRIOR TO FLASH)"
                               Style="{StaticResource PanelHeaderTextStyle}"
                               FontSize="9.5"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="RE-ANALYZE CODE"
                            Style="{StaticResource DockButtonStyle}"
                            Padding="8,3"
                            Click="OnReanalyzeClick" />
                </DockPanel>
                <TextBox x:Name="CodeEditorBox"
                         Grid.Row="1"
                         Style="{StaticResource DockTextBoxStyle}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="11"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Padding="8,6"
                         TextChanged="OnCodeEditorTextChanged" />
            </Grid>

            <!-- FLASH PROGRESS BAR & STAGE CONSOLE -->
            <Border Grid.Row="4" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock x:Name="UploadStageText"
                                   DockPanel.Dock="Left"
                                   Text="READY TO FLASH"
                                   Style="{StaticResource MonoTelemetryTextStyle}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock x:Name="UploadPercentText"
                                   DockPanel.Dock="Right"
                                   Text="0%"
                                   Style="{StaticResource MonoSecondaryTextStyle}"
                                   FontSize="10" />
                    </DockPanel>
                    <ProgressBar x:Name="UploadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="7"
                                 Background="#111114"
                                 Foreground="{StaticResource AccentCyanBrush}"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Margin="0,0,0,6" />
                    <TextBox x:Name="ConsoleOutputBox"
                             Style="{StaticResource ConsoleTextBoxStyle}"
                             Height="86"
                             FontSize="9.5"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- ACTION FOOTER -->
            <DockPanel Grid.Row="5" LastChildFill="False">
                <Button x:Name="OpenStudioButton"
                        DockPanel.Dock="Left"
                        Content="⚡ OPEN BOX CODING STUDIO"
                        Style="{StaticResource DockButtonStyle}"
                        Background="#3B1C54"
                        BorderBrush="#8A2BE2"
                        Foreground="#E1BEE7"
                        Padding="12,6"
                        Click="OnOpenBoxCodingStudioClick" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UploadNowButton"
                            Content="⬆ UPLOAD TO BOARD"
                            Style="{StaticResource DockButtonStyle}"
                            Background="#004D40"
                            BorderBrush="#00BFA5"
                            Foreground="#A7FFEB"
                            FontWeight="Bold"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            Click="OnUploadToBoardClick" />
                    <Button Content="CLOSE"
                            Style="{StaticResource DockButtonStyle}"
                            Padding="14,6"
                            IsCancel="True"
                            Click="OnCloseClick" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
