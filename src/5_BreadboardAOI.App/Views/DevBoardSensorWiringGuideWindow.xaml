<Window x:Class="BreadboardAOI.App.Views.DevBoardSensorWiringGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BreadboardAOI.App.ViewModels"
        xmlns:box="clr-namespace:BreadboardAOI.Core.BoxCoding;assembly=BreadboardAOI.Core"
        xmlns:drc="clr-namespace:BreadboardAOI.Core.DrcEngine;assembly=BreadboardAOI.Core"
        mc:Ignorable="d"
        Title="Breadboard AOI — DevBoard &amp; Sensor Wiring Guide Studio"
        Height="840" Width="1420"
        MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="#111217" Foreground="#F0F0F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="GuideButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252836" />
            <Setter Property="Foreground" Value="#ECEFF1" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3-Pane Content -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="#181A24" BorderBrush="#2A2D3D" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔌" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="WIRING &amp; INTERFACE TUTOR STUDIO" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Margin="12,0,0,0" Padding="6,2">
                        <TextBlock Text="HARDWARE TUTOR" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Board Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TARGET DEV BOARD:" Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableBoards}"
                              SelectedItem="{Binding SelectedBoardType, Mode=TwoWay}"
                              Width="190" Background="#232634" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="6,4" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗕 DOCK TO LEFT PANEL"
                            Command="{Binding DockToLeftPanelCommand}"
                            Style="{StaticResource GuideButtonStyle}"
                            Background="#0E7490" BorderBrush="#06B6D4" Foreground="#CFFAFE" Margin="0,0,8,0"
                            ToolTip="Minimize and dock this wiring guide directly into the Left Dock of the main workstation." />

                    <Button Content="✨ AUTO-DETECT CIRCUIT"
                            Command="{Binding AutoDetectCircuitCommand}"
                            Style="{StaticResource GuideButtonStyle}"
                            Background="#065F46" BorderBrush="#10B981" Foreground="#A7F3D0" Margin="0,0,8,0"
                            ToolTip="Scan placed sensors on the breadboard and display matching instructions." />

                    <Button Content="📋 COPY WIRING GUIDE"
                            Command="{Binding CopyMarkdownGuideCommand}"
                            Style="{StaticResource GuideButtonStyle}"
                            Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#BFDBFE"
                            ToolTip="Copy entire markdown wiring documentation to clipboard." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-PANE CONTENT -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Sensor Catalog (Width 280) -->
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="360" />
                <ColumnDefinition Width="6" />
                <!-- Center: Wiring Guide & Instructions (*) -->
                <ColumnDefinition Width="*" MinWidth="450" />
                <ColumnDefinition Width="6" />
                <!-- Right: Test Firmware (Width 380) -->
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: SENSOR CATALOG -->
            <Border Grid.Column="0" Background="#151722" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="6,6,0,0">
                        <TextBlock Text="📚 SENSOR &amp; MODULE CATALOG" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                    </Border>

                    <!-- Search Input -->
                    <Border Grid.Row="1" Padding="8,6" Background="#181A26">
                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F111A" Foreground="#FFFFFF" BorderBrush="#334155" Padding="6,4"
                                 FontSize="11" />
                    </Border>

                    <!-- Sensor List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredSensors}"
                             SelectedItem="{Binding SelectedSensor, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Background="#1E2130" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#1E3A8A" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#93C5FD" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding OperatingVoltage}" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- CENTER: WIRING INSTRUCTIONS & DOCUMENTATION -->
            <Border Grid.Column="2" Background="#151722" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="14,10" CornerRadius="6,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentGuide.Sensor.DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                                <TextBlock Text=" ⟷ " FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentGuide.BoardName}" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                        <StackPanel>
                            <!-- Summary & Metadata Pills -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentGuide.Sensor.OperatingVoltage, StringFormat='Supply: {0}'}" FontSize="11" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentGuide.Sensor.Protocol, StringFormat='Interface: {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding CurrentGuide.Sensor.TypicalCurrentMa, StringFormat='Current: ~{0} mA'}" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Level Shift Warning Banner if applicable -->
                            <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16"
                                    Visibility="{Binding CurrentGuide.IsLevelShiftingRequired, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="CRITICAL VOLTAGE LEVEL SHIFTING WARNING" FontWeight="Bold" FontSize="12" Foreground="#FCA5A5" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentGuide.LevelShiftingAdvice}" FontSize="11" Foreground="#FEE2E2" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 1: Function & Working Principle -->
                            <TextBlock Text="1. What It Does &amp; How It Works" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                            <Border Background="#1A1D2B" BorderBrush="#2E3347" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentGuide.Sensor.Summary}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="Operating Principle:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentGuide.Sensor.WorkingPrinciple}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Pin Connection & Jumper Wire Map -->
                            <TextBlock Text="2. Step-by-Step Pin Connection &amp; Wire Map" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                            <Border Background="#1A1D2B" BorderBrush="#2E3347" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding CurrentGuide.Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Background="#141622" BorderBrush="#2E3347" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding SensorPinNumber, StringFormat='Pin #{0}'}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SensorPinName}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="➔" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding TargetBoardPin}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />

                                                    <!-- Wire Color Badge -->
                                                    <Border Grid.Column="4" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WireColor}" FontSize="10" FontWeight="Bold" Foreground="{Binding WireColorHex}" />
                                                    </Border>

                                                    <!-- Explanation & Warning -->
                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Warning, StringFormat='⚠️ {0}'}" FontSize="10" Foreground="#F87171" FontWeight="Bold" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Section 3: External Components & Safety Rules -->
                            <TextBlock Text="3. Safety &amp; Circuit Rules" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                            <Border Background="#1A1D2B" BorderBrush="#2E3347" BorderThickness="1" CornerRadius="6" Padding="12">
                                <ItemsControl ItemsSource="{Binding CurrentGuide.Sensor.SafetyRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="•" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT: VERIFICATION TEST CODE -->
            <Border Grid.Column="4" Background="#151722" BorderBrush="#2A2D3D" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="⚡ VERIFICATION TEST CODE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋 INO" Command="{Binding CopyTestCodeCommand}" Style="{StaticResource GuideButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,0" ToolTip="Copy Arduino C++ (.ino) code" />
                                <Button Content="📋 PY" Command="{Binding CopyTestCodePyCommand}" Style="{StaticResource GuideButtonStyle}" Padding="6,2" FontSize="10" ToolTip="Copy MicroPython (.py) code" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Code Viewer -->
                    <TextBox Grid.Row="1"
                             Text="{Binding CurrentGuide.Sensor.MinimalTestCodeIno, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11"
                             Background="#0D0E15"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="10"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />

                    <!-- Quick Action -->
                    <Border Grid.Row="2" Background="#181A26" Padding="10" BorderBrush="#2A2D3D" BorderThickness="0,1,0,0">
                        <Button Content="📋 COPY ARDUINO VERIFICATION CODE"
                                Command="{Binding CopyTestCodeCommand}"
                                Style="{StaticResource GuideButtonStyle}"
                                Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#BFDBFE" FontWeight="Bold"
                                HorizontalAlignment="Stretch" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0F1015" BorderBrush="#232634" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#10B981" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Breadboard AOI Hardware Interface Tutor" FontSize="10" Foreground="#475569" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
