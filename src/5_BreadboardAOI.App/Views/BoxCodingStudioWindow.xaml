<Window x:Class="BreadboardAOI.App.Views.BoxCodingStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BreadboardAOI.App.ViewModels"
        xmlns:box="clr-namespace:BreadboardAOI.Core.BoxCoding;assembly=BreadboardAOI.Core"
        xmlns:drc="clr-namespace:BreadboardAOI.Core.DrcEngine;assembly=BreadboardAOI.Core"
        mc:Ignorable="d"
        Title="Breadboard AOI — Scratch-Style Box Coding Studio"
        Height="840" Width="1420"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterOwner"
        Background="#121318" Foreground="#F0F0F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Standard Button Style -->
        <Style x:Key="BoxStudioButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252836" />
            <Setter Property="Foreground" Value="#ECEFF1" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="border" Property="Background" Value="#374151" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BoxStudioButtonStyle}">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A78BFA" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9333EA" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#C084FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B21A8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                        <Setter Property="BorderBrush" Value="#00FFC8" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main 3-Column Content -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#181920" BorderBrush="#2D303E" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="SCRATCH BOX CODING STUDIO" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                        <TextBlock Text="CIRCUIT &amp; DEV BOARD AWARE" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="4" Margin="8,0,0,0" Padding="8,3" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="BorderBrush" Value="#475569" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                                        <Setter Property="Background" Value="#042F2E" />
                                        <Setter Property="BorderBrush" Value="#00FFC8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCableMismatchWarning}" Value="True">
                                        <Setter Property="Background" Value="#78350F" />
                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding GlobalConnectionBadgeText}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#00FFC8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCableMismatchWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#FDE68A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Board & Language Selectors -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="DEV BOARD:" Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableBoards}"
                              SelectedItem="{Binding SelectedBoardType, Mode=TwoWay}"
                              Width="180" Background="#232634" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="6,4" Margin="0,0,18,0" />

                    <TextBlock Text="LANGUAGE:" Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Width="170" Background="#232634" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="6,4" Margin="0,0,18,0">
                        <ComboBoxItem Content="Arduino C++ (.ino)" Tag="{x:Static box:TargetProgrammingLanguage.ArduinoCpp}" />
                        <ComboBoxItem Content="MicroPython (.py)" Tag="{x:Static box:TargetProgrammingLanguage.MicroPython}" />
                    </ComboBox>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📖 WIRING GUIDE"
                            Command="{Binding OpenWiringGuideCommand}"
                            Style="{StaticResource BoxStudioButtonStyle}"
                            Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#BFDBFE" Margin="0,0,8,0"
                            ToolTip="Open DevBoard &amp; Sensor Wiring Guide Studio with step-by-step connection instructions." />

                    <Button Content="✨ AUTO-DETECT"
                            Command="{Binding AutoDetectFromCircuitCommand}"
                            Style="{StaticResource BoxStudioButtonStyle}"
                            Background="#065F46" BorderBrush="#10B981" Foreground="#A7F3D0" Margin="0,0,8,0"
                            ToolTip="Scan placed components on the breadboard and populate matching blocks automatically." />

                    <Button Content="↺ RESET"
                            Command="{Binding ResetDefaultCommand}"
                            Style="{StaticResource BoxStudioButtonStyle}"
                            Margin="0,0,8,0" ToolTip="Reset script stack to starter template." />

                    <Button Content="⚡ CODE"
                            Command="{Binding RegenerateCodeCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Compile visual block boxes directly into production firmware code." />

                    <Button Content="⬆ SEND TO BOARD"
                            Command="{Binding SendToProgrammerCommand}"
                            FontWeight="Bold"
                            Padding="12,6"
                            ToolTip="Stage firmware and open Hardware Programmer to send onto connected board">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoxStudioButtonStyle}">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="BorderBrush" Value="#475569" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                                        <Setter Property="Background" Value="#004D40" />
                                        <Setter Property="BorderBrush" Value="#00FFC8" />
                                        <Setter Property="Foreground" Value="#A7FFEB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN CONTENT -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Palette Library -->
                <ColumnDefinition Width="330" MinWidth="270" MaxWidth="420" />
                <!-- GridSplitter 1 -->
                <ColumnDefinition Width="6" />
                <!-- Center: Active Script Stack & LCD Preview -->
                <ColumnDefinition Width="520" MinWidth="380" />
                <!-- GridSplitter 2 -->
                <ColumnDefinition Width="6" />
                <!-- Right: Generated Code Panel -->
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: BLOCK PALETTE -->
            <Border Grid.Column="0" Background="#161822" BorderBrush="#2D303E" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="📦 BLOCK PALETTE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayPaletteBlocks.Count, StringFormat='{}{0} Available'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Filter Bar: Search, Circuit Only Toggle & Category Pills -->
                    <Border Grid.Row="1" Background="#181A26" Padding="8,6" BorderBrush="#2D303E" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#12131A" Foreground="#F8FAFC" CaretBrush="#38BDF8"
                                         BorderBrush="#334155" BorderThickness="1" Padding="6,4" FontSize="11"
                                         ToolTip="Filter blocks by name, sensor model, category, or description." />
                            </Grid>

                            <CheckBox IsChecked="{Binding FilterCircuitOnly, Mode=TwoWay}"
                                      Content="Show Only Circuit-Matched Blocks"
                                      FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,6"
                                      ToolTip="Filters palette to display only blocks corresponding to dev boards and sensors present in the active circuit." />

                            <!-- Category Filter Tabs -->
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="ALL" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="ALL"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#1E293B" Foreground="#94A3B8" />
                                <Button Content="EVENTS" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Events"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#3E2723" Foreground="#F59E0B" />
                                <Button Content="SENSORS &amp; LCDs" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Sensors"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#0C4A6E" Foreground="#38BDF8"
                                        ToolTip="Sensors and LCD 1602 I2C Display Modules" />
                                <Button Content="DISPLAYS" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Displays"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#083344" Foreground="#06B6D4" />
                                <Button Content="ACTUATORS" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Actuators"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#880E4F" Foreground="#F472B6" />
                                <Button Content="LOGIC" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Logic"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#3B0764" Foreground="#A78BFA" />
                                <Button Content="CONTROL" Command="{Binding SelectCategoryFilterCommand}" CommandParameter="Control"
                                        Style="{StaticResource BoxStudioButtonStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,4" Background="#263238" Foreground="#94A3B8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Palette Items -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                        <ItemsControl ItemsSource="{Binding DisplayPaletteBlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="{Binding BackgroundHexColor}" BorderBrush="{Binding AccentHexColor}"
                                            BorderThickness="2,1,1,1" CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                    <!-- Model Badge -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Background="#0E7490" BorderBrush="#22D3EE" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ModelName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ModelName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ModelName}" FontSize="8" FontWeight="Bold" Foreground="#67E8F9" />
                                                    </Border>
                                                    <!-- Circuit Matched Glow Tag -->
                                                    <Border Background="#065F46" BorderBrush="#34D399" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="4,1"
                                                            Visibility="{Binding IsCircuitMatched, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="CIRCUIT" FontSize="8" FontWeight="Bold" Foreground="#A7F3D0" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="+ ADD"
                                                    Command="{Binding DataContext.AddBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BoxStudioButtonStyle}"
                                                    Background="#1E293B" BorderBrush="{Binding AccentHexColor}"
                                                    Foreground="{Binding AccentHexColor}" FontWeight="Bold" FontSize="10"
                                                    Padding="6,4" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- CENTER: ACTIVE SCRATCH SCRIPT STACK & HARDWARE SIMULATION -->
            <Border Grid.Column="2" Background="#161822" BorderBrush="#2D303E" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="🧩 PROGRAM BOX SCRIPT (EXECUTION ORDER)" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Blocks.Count, StringFormat='{}{0} Block(s)'}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Scrollable Blocks Stack -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                        <ItemsControl ItemsSource="{Binding Blocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- JIGSAW SCRATCH CARD WITH VISUAL INDENTATION RAIL -->
                                    <Grid PreviewMouseLeftButtonDown="OnBlockCardPreviewMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="{Binding IndentationLeft}"
                                                BorderBrush="#6366F1"
                                                BorderThickness="0,0,2,0"
                                                Margin="0,2,4,10"
                                                Opacity="0.65">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IndentationLevel}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Column="1" Background="#1E2232" BorderBrush="{Binding AccentHexColor}"
                                                BorderThickness="5,1,1,1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Card Header: Icon, Title, Model, Nestable Pill, Reorder, Duplicate & Indent Controls -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                                  ToolTip="Enable or disable block in compilation" />
                                                        <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                        <!-- Model Badge -->
                                                        <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Background="#0E7490" BorderBrush="#22D3EE" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ModelName}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ModelName}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ModelName}" FontSize="8" FontWeight="Bold" Foreground="#67E8F9" />
                                                        </Border>
                                                        <!-- Nestable Container Badge -->
                                                        <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Background="#312E81" BorderBrush="#818CF8" BorderThickness="1"
                                                                Visibility="{Binding IsContainerBlock, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="NESTABLE" FontSize="8" FontWeight="Bold" Foreground="#C7D2FE" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Reorder / Indent / Duplicate / Delete Controls -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▲" ToolTip="Move block up in execution sequence"
                                                                Command="{Binding DataContext.MoveBlockUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="2,0"
                                                                Background="#2D303E" Foreground="#94A3B8" BorderThickness="0" />
                                                        <Button Content="▼" ToolTip="Move block down in execution sequence"
                                                                Command="{Binding DataContext.MoveBlockDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="2,0"
                                                                Background="#2D303E" Foreground="#94A3B8" BorderThickness="0" />
                                                        <Button Content="⇤" ToolTip="Outdent block (decrease indentation level)"
                                                                Command="{Binding DataContext.OutdentBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="2,0"
                                                                Background="#2D303E" Foreground="#94A3B8" BorderThickness="0" />
                                                        <Button Content="⇥" ToolTip="Indent block (increase indentation level)"
                                                                Command="{Binding DataContext.IndentBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="2,0"
                                                                Background="#2D303E" Foreground="#94A3B8" BorderThickness="0" />
                                                        <Button Content="⧉" ToolTip="Duplicate this block right below"
                                                                Command="{Binding DataContext.DuplicateBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="2,0"
                                                                Background="#2D303E" Foreground="#93C5FD" BorderThickness="0" />
                                                        <Button Content="✕" ToolTip="Delete block from script"
                                                                Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                                Background="#7F1D1D" Foreground="#F87171" BorderThickness="0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Inline Parameter Editors -->
                                                <WrapPanel Grid.Row="1" Margin="24,8,0,0" Orientation="Horizontal">
                                                    <!-- Primary Pin Input (Smart Suggestions ComboBox) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="PIN:" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <ComboBox ItemsSource="{Binding DataContext.BoardSuggestedDigitalPins, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Text="{Binding Pin1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  Width="78" Background="#12131A" Foreground="#38BDF8" BorderBrush="#334155" Padding="4,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- Secondary Pin Input (if ultrasonic) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="ECHO:" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <ComboBox ItemsSource="{Binding DataContext.BoardSuggestedDigitalPins, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Text="{Binding Pin2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  Width="78" Background="#12131A" Foreground="#38BDF8" BorderBrush="#334155" Padding="4,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- Param1 (State / Angle / Freq / Text / InRange) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="PARAM:" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBox Text="{Binding Parameter1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="80" Background="#12131A" Foreground="#FBBF24" BorderBrush="#334155" Padding="4,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- Param2 (Duration ms / OutRange / Secondary Value) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="PARAM 2:" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBox Text="{Binding Parameter2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="72" Background="#12131A" Foreground="#FBBF24" BorderBrush="#334155" Padding="4,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- LCD Row & Col (for Displays) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="ROW:" FontSize="10" Foreground="#06B6D4" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding LcdRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="24" Background="#12131A" Foreground="#67E8F9" BorderBrush="#334155" Padding="2,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="COL:" FontSize="10" Foreground="#06B6D4" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,3,0" />
                                                        <TextBox Text="{Binding LcdCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="26" Background="#12131A" Foreground="#67E8F9" BorderBrush="#334155" Padding="2,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Variable Name (for Logic / Conditions) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="VAR:" FontSize="10" Foreground="#A78BFA" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding VariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="72" Background="#12131A" Foreground="#C4B5FD" BorderBrush="#334155" Padding="3,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- Condition Operator & Threshold -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="OP:" FontSize="10" Foreground="#A78BFA" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding ConditionOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="32" Background="#12131A" Foreground="#E9D5FF" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="TH:" FontSize="10" Foreground="#A78BFA" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,3,0" />
                                                        <TextBox Text="{Binding ConditionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="44" Background="#12131A" Foreground="#E9D5FF" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Secondary Condition (for Compound Logic) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="SEC VAR:" FontSize="10" Foreground="#C084FC" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding SecondaryVariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="68" Background="#12131A" Foreground="#E9D5FF" BorderBrush="#334155" Padding="3,2" FontSize="11" />
                                                        <TextBlock Text="OP:" FontSize="10" Foreground="#C084FC" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,3,0" />
                                                        <TextBox Text="{Binding SecondaryConditionOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="30" Background="#12131A" Foreground="#E9D5FF" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="TH:" FontSize="10" Foreground="#C084FC" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,3,0" />
                                                        <TextBox Text="{Binding SecondaryConditionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="40" Background="#12131A" Foreground="#E9D5FF" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Math Calculation Fields -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="TARGET:" FontSize="10" Foreground="#34D399" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding MathTargetVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="60" Background="#12131A" Foreground="#A7F3D0" BorderBrush="#334155" Padding="3,2" FontSize="11" />
                                                        <TextBlock Text="=" FontSize="11" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,4,0" />
                                                        <TextBox Text="{Binding Operand1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="56" Background="#12131A" Foreground="#A7F3D0" BorderBrush="#334155" Padding="3,2" FontSize="11" />
                                                        <TextBox Text="{Binding MathOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="26" Background="#12131A" Foreground="#F59E0B" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" Margin="4,0,4,0" />
                                                        <TextBox Text="{Binding Operand2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="44" Background="#12131A" Foreground="#A7F3D0" BorderBrush="#334155" Padding="3,2" FontSize="11" />
                                                    </StackPanel>

                                                    <!-- Repeat Count (for Repeat Loop) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="REPEAT:" FontSize="10" Foreground="#818CF8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="36" Background="#12131A" Foreground="#C7D2FE" BorderBrush="#334155" Padding="3,2" FontSize="11" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="TIMES" FontSize="10" Foreground="#818CF8" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" />
                                                    </StackPanel>

                                                    <!-- Custom Message / Format -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <TextBlock Text="MSG / FORMAT:" FontSize="10" Foreground="#34D399" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                        <TextBox Text="{Binding CustomMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="120" Background="#12131A" Foreground="#6EE7B7" BorderBrush="#334155" Padding="3,2" FontSize="11"
                                                                 ToolTip="Text string or format template (e.g. Temp: &quot;temp&quot;C or Temp: {temp}C)" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- LCD 1602 LIVE HARDWARE SIMULATION PREVIEW -->
                    <Border Grid.Row="2" Background="#0C0E14" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="LCD1602 I2C HARDWARE SIMULATION" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#065F46" />
                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLcdStimulated}" Value="False">
                                                        <Setter Property="Background" Value="#374151" />
                                                        <Setter Property="BorderBrush" Value="#6B7280" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="8" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="STIMULATED (ON)" />
                                                    <Setter Property="Foreground" Value="#6EE7B7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLcdStimulated}" Value="False">
                                                            <Setter Property="Text" Value="TURNED OFF (UNPOWERED)" />
                                                            <Setter Property="Foreground" Value="#9CA3AF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="TOGGLE ON/OFF"
                                        Command="{Binding ToggleLcdStimulationCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        FontSize="9" Padding="6,2" Height="20"
                                        ToolTip="Test how LCD appears turned off vs stimulated with live coded telemetry" />
                            </DockPanel>

                            <!-- Physical 16x2 Bezel Display -->
                            <Border Grid.Row="1" CornerRadius="4" Padding="10,6" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Stimulated blue backlit matrix -->
                                        <Setter Property="Background" Value="#0B408C" />
                                        <Setter Property="BorderBrush" Value="#0369A1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLcdStimulated}" Value="False">
                                                <!-- Turned off dark liquid crystal -->
                                                <Setter Property="Background" Value="#0D1117" />
                                                <Setter Property="BorderBrush" Value="#1F2937" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding LcdSimulatedRow0}"
                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                               FontWeight="Bold" FontSize="13" Margin="2,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLcdStimulated}" Value="False">
                                                        <Setter Property="Foreground" Value="#334155" />
                                                        <Setter Property="Text" Value="----------------" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LcdSimulatedRow1}"
                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                               FontWeight="Bold" FontSize="13" Margin="2,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLcdStimulated}" Value="False">
                                                        <Setter Property="Foreground" Value="#334155" />
                                                        <Setter Property="Text" Value="----------------" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT: VS CODE-STYLE EDITOR, INTERACTIVE DEBUGGER, PROBLEMS & QUICK FIXES -->
            <Border Grid.Column="4" Background="#161822" BorderBrush="#2D303E" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="240" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="6,6,0,0" BorderBrush="#2D303E" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💻 VS CODE EDITOR &amp; DEBUGGER" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="3" Margin="8,0,0,0" Padding="5,1">
                                        <TextBlock Text="EDITABLE" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" />
                                    </Border>
                                    <Border Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="5,1"
                                            Visibility="{Binding IsManualCodeEdit, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="MANUAL CODE EDIT" FontSize="9" FontWeight="Bold" Foreground="#FDE68A" />
                                    </Border>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DebugStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </DockPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="🔍 CHECK ERRORS"
                                        Command="{Binding CheckCodeErrorsCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        Background="#312E81" BorderBrush="#6366F1" Foreground="#C7D2FE" FontSize="11" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="Run syntax, semantic &amp; logic error analysis on current firmware source code." />

                                <Button Content="🛠 GCC / AST CHECK"
                                        Command="{Binding RunExternalCompilerCheckCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        Background="#1E293B" BorderBrush="#38BDF8" Foreground="#BAE6FD" FontSize="11" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="Invoke local arduino-cli or python AST syntax verifier when installed." />

                                <Button Content="↺ RESYNC BLOCKS"
                                        Command="{Binding ResyncCodeFromBlocksCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        Background="#252836" BorderBrush="#4B5563" Foreground="#E2E8F0" FontSize="11" Padding="8,4" Margin="0,0,6,4"
                                        ToolTip="Overwrite manual edits and regenerate firmware directly from visual blocks." />

                                <Button Content="⚡ SEND TO PROGRAMMER"
                                        Command="{Binding SendToProgrammerCommand}"
                                        FontWeight="Bold" FontSize="11" Padding="9,4" Margin="0,0,6,4"
                                        ToolTip="Validate and stage this firmware in the Hardware Programmer for flashing.">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BoxStudioButtonStyle}">
                                            <Setter Property="Background" Value="#065F46" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#A7F3D0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                                                    <Setter Property="Background" Value="#004D40" />
                                                    <Setter Property="BorderBrush" Value="#00FFC8" />
                                                    <Setter Property="Foreground" Value="#00FFC8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="📋 COPY"
                                        Command="{Binding CopyCodeCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#93C5FD" FontWeight="Bold" FontSize="11" Padding="8,4" Margin="0,0,6,4" />

                                <Button Content="💾 EXPORT"
                                        Command="{Binding ExportCodeCommand}"
                                        Style="{StaticResource BoxStudioButtonStyle}"
                                        Background="#374151" BorderBrush="#6B7280" Foreground="#E5E7EB" FontSize="11" Padding="8,4" Margin="0,0,0,4" />
                            </WrapPanel>

                            <!-- INTERACTIVE DEBUGGER BAR -->
                            <Border Background="#111420" BorderBrush="#2A3348" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DEBUG:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Content="▶ CONTINUE" Command="{Binding DebugStartOrContinueCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#064E3B" BorderBrush="#10B981" Foreground="#6EE7B7" FontSize="10" Padding="7,3" Margin="0,0,4,0" />
                                    <Button Content="⏸ PAUSE" Command="{Binding DebugPauseCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#374151" BorderBrush="#9CA3AF" Foreground="#F3F4F6" FontSize="10" Padding="7,3" Margin="0,0,4,0" />
                                    <Button Content="↷ STEP OVER" Command="{Binding DebugStepOverCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#1E3A8A" BorderBrush="#60A5FA" Foreground="#DBEAFE" FontSize="10" Padding="7,3" Margin="0,0,4,0" />
                                    <Button Content="↓ STEP INTO" Command="{Binding DebugStepIntoCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#1E3A8A" BorderBrush="#60A5FA" Foreground="#DBEAFE" FontSize="10" Padding="7,3" Margin="0,0,4,0" />
                                    <Button Content="⏹ RESET" Command="{Binding DebugResetCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#450A0A" BorderBrush="#EF4444" Foreground="#FCA5A5" FontSize="10" Padding="7,3" Margin="0,0,10,0" />

                                    <TextBlock Text="INJECT PIN:" Foreground="#94A3B8" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding DebugSimulatedPinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="44" Background="#0D0E15" Foreground="#F8FAFC" BorderBrush="#334155" Padding="4,2" FontSize="10" Margin="0,0,4,0" />
                                    <Button Content="HIGH" Command="{Binding InjectSimulatedPinHighCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#065F46" BorderBrush="#34D399" Foreground="#A7F3D0" FontSize="9.5" Padding="6,2" Margin="0,0,3,0" />
                                    <Button Content="LOW" Command="{Binding InjectSimulatedPinLowCommand}" Style="{StaticResource BoxStudioButtonStyle}" Background="#334155" BorderBrush="#64748B" Foreground="#E2E8F0" FontSize="9.5" Padding="6,2" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- VS CODE-STYLE GUTTER (LINE NUMBERS / BREAKPOINTS / DIAGNOSTIC MARKERS) + CODE EDITOR -->
                    <Grid Grid.Row="1" Background="#0D0E15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="GutterScrollViewer"
                                      Grid.Column="0"
                                      Background="#11131D"
                                      BorderBrush="#232634"
                                      BorderThickness="0,0,1,0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="EditorGutterList" Margin="0,12,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="16"
                                                Background="{Binding RowBackgroundBrush}"
                                                Cursor="Hand"
                                                ToolTip="{Binding GutterTooltip}"
                                                MouseLeftButtonDown="OnGutterLineMouseLeftButtonDown">
                                            <Grid Margin="3,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Visibility="{Binding BreakpointVisibility}" />
                                                <TextBlock Grid.Column="0" Text="▶" FontSize="9" Foreground="#FACC15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Visibility="{Binding CurrentLineVisibility}" />
                                                <Ellipse Grid.Column="1" Width="5" Height="5" Fill="{Binding DiagnosticDotBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Visibility="{Binding DiagnosticVisibility}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LineNumber}"
                                                           FontFamily="Consolas, Cascadia Code, Courier New"
                                                           FontSize="10.5"
                                                           Foreground="{Binding LineNumberBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBox x:Name="FirmwareCodeEditorBox"
                                 Grid.Column="1"
                                 Text="{Binding GeneratedCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="False"
                                 AcceptsTab="True"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 TextBlock.LineHeight="16"
                                 TextBlock.LineStackingStrategy="BlockLineHeight"
                                 Background="#0D0E15"
                                 Foreground="#E2E8F0"
                                 CaretBrush="#38BDF8"
                                 BorderThickness="0"
                                 Padding="10,12,12,12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.ScrollChanged="OnCodeEditorScrollChanged" />
                    </Grid>

                    <!-- VS CODE BOTTOM PANEL: PROBLEMS (CLICK TO JUMP + QUICK FIX) & INTERACTIVE DEBUGGER WATCHES -->
                    <Border Grid.Row="2" Background="#0F111A" BorderBrush="#2D303E" BorderThickness="0,1,0,0" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Diagnostics Status Banner -->
                            <Border Grid.Row="0" CornerRadius="4" Padding="8,4" BorderThickness="1" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#064E3B" />
                                        <Setter Property="BorderBrush" Value="#10B981" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCodeWarnings}" Value="True">
                                                <Setter Property="Background" Value="#78350F" />
                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasCodeErrors}" Value="True">
                                                <Setter Property="Background" Value="#7F1D1D" />
                                                <Setter Property="BorderBrush" Value="#F87171" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsManualCodeEdit, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="MANUAL CODE EDIT" FontSize="9" FontWeight="Bold" Foreground="#FDE68A" />
                                    </Border>
                                    <TextBlock Text="{Binding CodeErrorSummary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6EE7B7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCodeWarnings}" Value="True">
                                                        <Setter Property="Foreground" Value="#FDE68A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasCodeErrors}" Value="True">
                                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <TabControl Grid.Row="1" Background="#0F111A" BorderBrush="#2D303E" BorderThickness="1">
                                <!-- TAB 1: PROBLEMS + QUICK FIXES -->
                                <TabItem Header="PROBLEMS &amp; QUICK FIXES">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                                        <ItemsControl ItemsSource="{Binding CodeDiagnostics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#181B28" BorderBrush="#2D303E" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" CornerRadius="3" Padding="5,1" Margin="0,1,8,0" VerticalAlignment="Top">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1E3A8A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static box:BoxCodeDiagnosticSeverity.Warning}">
                                                                                <Setter Property="Background" Value="#78350F" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static box:BoxCodeDiagnosticSeverity.Error}">
                                                                                <Setter Property="Background" Value="#7F1D1D" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding SeverityLabel}" FontSize="9" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#93C5FD" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static box:BoxCodeDiagnosticSeverity.Warning}">
                                                                                    <Setter Property="Foreground" Value="#FDE68A" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static box:BoxCodeDiagnosticSeverity.Error}">
                                                                                    <Setter Property="Foreground" Value="#FCA5A5" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.JumpToDiagnosticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand"
                                                                    ToolTip="Click to jump editor caret to this line &amp; column">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplaySummary}" FontSize="10.5" Foreground="#F1F5F9" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Suggestion, StringFormat='Suggestion: {0}'}" FontSize="9.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,1,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Suggestion}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Suggestion}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Grid.Column="2"
                                                                    Visibility="{Binding HasQuickFix, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.ApplyQuickFixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="⚡ FIX"
                                                                    Style="{StaticResource BoxStudioButtonStyle}"
                                                                    Background="#064E3B" BorderBrush="#10B981" Foreground="#6EE7B7"
                                                                    FontSize="9.5" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="{Binding QuickFix.Title}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 2: WATCH VARIABLES & MCU PINS -->
                                <TabItem Header="WATCH VARIABLES &amp; PINS">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DebugWatchVariables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#181B28" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#93C5FD" />
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TypeName, StringFormat=' ({0})'}" FontSize="9.5" Foreground="#64748B" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueDisplay}" FontWeight="Bold" FontSize="10" Foreground="#34D399" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DebugWatchPins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#181B28" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PinName}" FontWeight="Bold" FontSize="10" Foreground="#FBBF24" />
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mode, StringFormat=' [{0}]'}" FontSize="9" Foreground="#94A3B8" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontWeight="Bold" FontSize="10" Foreground="#00FFC8" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>

                                <!-- TAB 3: CALL STACK & DEBUG SERIAL -->
                                <TabItem Header="CALL STACK &amp; SERIAL">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DebugCallStack}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#181B28" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                                            <TextBlock FontSize="10" Foreground="#E2E8F0">
                                                                <Run Text="{Binding FunctionName, Mode=OneWay}" Foreground="#F472B6" FontWeight="Bold" />
                                                                <Run Text="{Binding Line, StringFormat=' : L{0} — ', Mode=OneWay}" Foreground="#94A3B8" />
                                                                <Run Text="{Binding Summary, Mode=OneWay}" Foreground="#CBD5E1" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DebugSerialLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#34D399" TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0F1015" BorderBrush="#232634" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#10B981" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlobalConnectionBadgeText}" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgrammerCableConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#00FFC8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCableMismatchWarning}" Value="True">
                                        <Setter Property="Foreground" Value="#FDE68A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Breadboard AOI Studio v2.4" FontSize="10" Foreground="#475569" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
