<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BreadboardAOI_Setup</AssemblyName>
    <RootNamespace>BreadboardAOI.Installer</RootNamespace>
    
    <!-- Windows PE Resource Icon (Explorer renders official app icon on exe) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Single-File Self-Extracting Executable (Gemini Setup aesthetic) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Assembly & Explorer Version Metadata -->
    <AssemblyTitle>Breadboard AOI Workstation Setup</AssemblyTitle>
    <Description>Google Installer (x64) — Real-Time Circuit Verification Workstation</Description>
    <Company>Breadboard AOI Systems</Company>
    <Product>Breadboard AOI Workstation</Product>
    <Copyright>Copyright © 2026</Copyright>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\1_BreadboardAOI.Hardware\1_BreadboardAOI.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Split payload parts avoid the C# compiler OOM when embedding >500 MB. -->
    <EmbeddedResource Include="Payload.zip.part*" LogicalName="BreadboardAOI.EmbeddedPayload%(Extension)" Condition="Exists('Payload.zip.part001')" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
